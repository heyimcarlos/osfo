    {
      "id": 1,
      "title": "Durability hierarchy",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "content": "> **Derived presentation view.** Grafana is not evidence authority. The importer verifies the sealed bundle first. Use the provenance table to locate its checksum manifest. Missing evidence stays **MISSING**.\n\nProcess cuts, dependency outage, redelivery, fencing, recovery rate, and drain time require their own sealed scenarios. Exact steady-run reconciliation does not automatically certify recovery.",
        "mode": "markdown"
      }
    },
    {
      "id": 2,
      "title": "Exact accepted-work reconciliation",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "openpoke-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "color": "red",
                  "index": 1,
                  "text": "FAIL"
                },
                "1": {
                  "color": "green",
                  "index": 0,
                  "text": "PASS"
                },
                "-1": {
                  "color": "gray",
                  "index": 2,
                  "text": "MISSING"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray",
