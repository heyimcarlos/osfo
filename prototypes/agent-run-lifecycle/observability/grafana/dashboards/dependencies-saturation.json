        {"expr": "rate(pg_stat_database_xact_commit{datname=\"osfo_lifecycle\"}[$__rate_interval])", "legendFormat": "commits/s", "refId": "A"},
        {"expr": "rate(pg_stat_database_tup_inserted{datname=\"osfo_lifecycle\"}[$__rate_interval])", "legendFormat": "rows inserted/s", "refId": "B"},
        {"expr": "rate(pg_stat_database_tup_updated{datname=\"osfo_lifecycle\"}[$__rate_interval])", "legendFormat": "rows updated/s", "refId": "C"}
      ],
      "title": "Cloud SQL write work",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "osfo-prometheus"},
