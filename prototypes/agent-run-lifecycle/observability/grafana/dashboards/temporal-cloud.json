{
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "gridPos": {"h": 4, "w": 24, "x": 0, "y": 0},
      "id": 1,
      "options": {
        "content": "# Temporal Cloud confirmation\nCloud values are pre-aggregated over one-minute windows and arrive about three minutes later with source timestamps. Burst conclusions must use Osfo and SDK histograms beside these Cloud gauges. Cloud percentile series are shown by their native dimensions and are never re-aggregated.",
        "mode": "markdown"
      },
      "title": "Evidence interpretation",
      "type": "text"
    },
    {
      "datasource": {"type": "prometheus", "uid": "osfo-prometheus"},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 4},
      "id": 2,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}},
      "targets": [
        {"expr": "sum(temporal_cloud_v1_total_action_count{is_background=\"false\"})", "legendFormat": "billable action rate", "refId": "A"},
        {"expr": "max(temporal_cloud_v1_action_limit)", "legendFormat": "action limit", "refId": "B"}
      ],
      "title": "Temporal Cloud APS used versus limit",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "osfo-prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0}, "overrides": []},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 4},
      "id": 3,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}},
      "targets": [
        {"expr": "sum(temporal_cloud_v1_total_action_count{is_background=\"false\"}) / max(temporal_cloud_v1_action_limit)", "legendFormat": "APS utilization", "refId": "A"},
        {"expr": "sum(temporal_cloud_v1_service_request_count) / max(temporal_cloud_v1_service_request_limit)", "legendFormat": "frontend request utilization", "refId": "B"}
      ],
      "title": "Cloud limit utilization",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "osfo-prometheus"},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 13},
      "id": 4,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}},
      "targets": [
        {"expr": "sum(temporal_cloud_v1_total_action_throttled_count) or vector(0)", "legendFormat": "actions throttled/s", "refId": "A"},
        {"expr": "sum(temporal_cloud_v1_service_request_throttled_count) or vector(0)", "legendFormat": "requests throttled/s", "refId": "B"},
        {"expr": "sum(temporal_cloud_v1_resource_exhausted_error_count) or vector(0)", "legendFormat": "resource exhausted/s", "refId": "C"},
        {"expr": "sum(temporal_cloud_v1_service_error_count) or vector(0)", "legendFormat": "service errors/s", "refId": "D"}
      ],
      "title": "Cloud throttling and service errors",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "osfo-prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 13},
      "id": 5,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}},
      "targets": [
        {"expr": "temporal_cloud_v1_approximate_backlog_count", "legendFormat": "{{temporal_task_queue}} {{task_type}} priority {{task_priority}}", "refId": "A"},
        {"expr": "temporal_cloud_v1_namespace_open_workflows", "legendFormat": "open workflows", "refId": "B"},
        {"expr": "temporal_cloud_v1_no_poller_tasks_count", "legendFormat": "{{temporal_task_queue}} no-poller {{task_type}}", "refId": "C"}
      ],
      "title": "Cloud task queues and open workflows",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "osfo-prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 10, "w": 12, "x": 0, "y": 22},
      "id": 6,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}},
      "targets": [
        {"expr": "temporal_cloud_v1_service_latency_p50", "legendFormat": "p50 {{operation}}", "refId": "A"},
        {"expr": "temporal_cloud_v1_service_latency_p95", "legendFormat": "p95 {{operation}}", "refId": "B"},
        {"expr": "temporal_cloud_v1_service_latency_p99", "legendFormat": "p99 {{operation}}", "refId": "C"}
      ],
      "title": "Cloud frontend latency by operation",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "osfo-prometheus"},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "gridPos": {"h": 10, "w": 12, "x": 12, "y": 22},
      "id": 7,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}},
      "targets": [
        {"expr": "sum by (temporal_workflow_type) (temporal_cloud_v1_workflow_success_count)", "legendFormat": "success {{temporal_workflow_type}}", "refId": "A"},
        {"expr": "sum by (temporal_workflow_type) (temporal_cloud_v1_workflow_failed_count)", "legendFormat": "failed {{temporal_workflow_type}}", "refId": "B"},
        {"expr": "sum by (temporal_workflow_type) (temporal_cloud_v1_workflow_cancel_count)", "legendFormat": "canceled {{temporal_workflow_type}}", "refId": "C"},
        {"expr": "sum by (temporal_workflow_type) (temporal_cloud_v1_workflow_timeout_count)", "legendFormat": "timed out {{temporal_workflow_type}}", "refId": "D"}
      ],
      "title": "Cloud workflow terminal rates",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "osfo-prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 32},
      "id": 8,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}},
      "targets": [
        {"expr": "temporal_cloud_v1_workflow_schedule_to_close_latency_p50", "legendFormat": "p50 {{temporal_workflow_type}}", "refId": "A"},
        {"expr": "temporal_cloud_v1_workflow_schedule_to_close_latency_p95", "legendFormat": "p95 {{temporal_workflow_type}}", "refId": "B"},
        {"expr": "temporal_cloud_v1_workflow_schedule_to_close_latency_p99", "legendFormat": "p99 {{temporal_workflow_type}}", "refId": "C"}
      ],
      "title": "Cloud workflow schedule-to-close latency",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "osfo-prometheus"},
      "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 32},
      "id": 9,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(temporal_workflow_task_schedule_to_start_latency_milliseconds_bucket[$__rate_interval])))", "legendFormat": "workflow p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(temporal_workflow_task_schedule_to_start_latency_milliseconds_bucket[$__rate_interval])))", "legendFormat": "workflow p95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(temporal_workflow_task_schedule_to_start_latency_milliseconds_bucket[$__rate_interval])))", "legendFormat": "workflow p99", "refId": "C"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(temporal_activity_schedule_to_start_latency_milliseconds_bucket[$__rate_interval])))", "legendFormat": "activity p99", "refId": "D"}
      ],
      "title": "Worker SDK schedule-to-start latency",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "osfo-prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 41},
      "id": 10,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}},
      "targets": [
        {"expr": "sum by (worker_type) (temporal_worker_task_slots_available)", "legendFormat": "available {{worker_type}}", "refId": "A"},
        {"expr": "sum by (worker_type) (temporal_worker_task_slots_used)", "legendFormat": "used {{worker_type}}", "refId": "B"},
        {"expr": "sum by (worker_type) (temporal_num_pollers)", "legendFormat": "pollers {{worker_type}}", "refId": "C"}
      ],
      "title": "Worker SDK slots and pollers",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "osfo-prometheus"},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 41},
      "id": 11,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}},
      "targets": [
        {"expr": "sum by (action_type, temporal_workflow_type) (temporal_cloud_v1_billable_action_count)", "legendFormat": "{{action_type}} {{temporal_workflow_type}}", "refId": "A"}
      ],
      "title": "Billable actions by type",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 42,
  "tags": ["osfo", "issue-13", "temporal-cloud", "capacity"],
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "utc",
  "title": "Issue 13 Temporal Cloud capacity",
  "uid": "osfo-temporal-cloud-capacity",
  "version": 1
