# Non-secret runtime configuration for cloud-sql-auth-proxy.service. The proxy
# authenticates through the runner VM service account, so no credential is
# stored here.
OSFO_CLOUD_SQL_CONNECTION_NAME=project:region:instance
# Bind only to the runner's Docker bridge. The host workload reaches this
# address directly and postgres-exporter reaches it as host.docker.internal.
OSFO_CLOUD_SQL_PROXY_ADDRESS=172.17.0.1
OSFO_CLOUD_SQL_PROXY_PORT=55432
