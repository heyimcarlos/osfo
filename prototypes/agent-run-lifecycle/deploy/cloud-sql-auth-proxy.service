[Unit]
Description=Osfo issue 13 Cloud SQL Auth Proxy
Documentation=https://cloud.google.com/sql/docs/postgres/sql-proxy
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=simple
User=ren
Group=ren
EnvironmentFile=/home/ren/.config/osfo/cloud-sql-auth-proxy.env
ExecStart=/usr/local/bin/cloud-sql-proxy --auto-iam-authn --address=${OSFO_CLOUD_SQL_PROXY_ADDRESS} --port=${OSFO_CLOUD_SQL_PROXY_PORT} ${OSFO_CLOUD_SQL_CONNECTION_NAME}
Restart=always
RestartSec=2s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
