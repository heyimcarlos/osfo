FROM rust:1.94.1-bookworm@sha256:6ae102bdbf528294bc79ad6e1fae682f6f7c2a6e6621506ba959f9685b308a55 AS builder
RUN apt-get update \
    && apt-get install -y --no-install-recommends libprotobuf-dev protobuf-compiler \
    && protoc --version \
    && dpkg-query --show --showformat='${Package}=${Version}\n' protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY schema.sql ./
COPY src ./src
RUN cargo build --locked --release --no-default-features --features temporal-cloud \
    --bin temporal_cloud_worker

FROM debian:bookworm-slim@sha256:7b140f374b289a7c2befc338f42ebe6441b7ea838a042bbd5acbfca6ec875818
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=builder /build/target/release/temporal_cloud_worker /usr/local/bin/temporal_cloud_worker
USER 65532:65532
EXPOSE 9465
ENTRYPOINT ["/usr/local/bin/temporal_cloud_worker"]
