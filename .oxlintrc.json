{
  "$schema": "./node_modules/@effect/tsgo/oxlint-schema.json",
  "extends": [
    "./node_modules/@effect/tsgo/oxlint-presets/recommended.json",
    "./tools/oxlint/oxlintrc.json"
  ],
  "options": {
    "typeAware": true
  },
  "plugins": ["effecttsgo"],
  "jsPlugins": [
    {
      "name": "osfo",
      "specifier": "./tools/oxlint/index.ts"
    }
  ],
  "rules": {
    "osfo/no-chained-type-assertions": "error",
    "osfo/no-conditional-empty-object-spread": "error",
    "osfo/no-cross-package-relative-imports": "error",
    "osfo/no-known-value-widening": "error",
    "osfo/no-module-mocking": "error",
    "osfo/no-object-parameters": "error",
    "osfo/no-raw-fetch": "error",
    "osfo/no-reflect-apply": "error",
    "osfo/no-reflect-get": "error",
    "osfo/no-runtime-typeof": "error",
    "osfo/no-shape-in-symbol-names": "error",
    "osfo/no-unknown-parameters": "error",
    "osfo/no-unknown-returns": "error",
    "osfo/no-unknown-type-aliases": "error",
    "osfo/no-unsafe-dictionary-type": "error",
    "osfo/no-widen-then-assert": "error",
    "osfo/require-safety-comment-for-type-assertion": "error"
  },
  "overrides": [
    {
      "files": ["apps/web/src/App.tsx"],
      "rules": {
        "effecttsgo/crypto-random-uuid": "off"
      }
    },
    {
      "files": ["apps/worker/test/**/*.test.ts"],
      "rules": {
        "vitest/no-standalone-expect": "off"
      }
    },
    {
      "files": ["tools/oxlint/**/*.ts"],
      "rules": {
        "effecttsgo/node-builtin-import": "off"
      }
    },
    {
      "files": ["scripts/**/*.ts"],
      "rules": {
        "effecttsgo/async-function": "off",
        "effecttsgo/global-console": "off",
        "effecttsgo/node-builtin-import": "off",
        "eslint/no-console": "off"
      }
    }
  ],
  "ignorePatterns": [
    ".reference/",
    ".typescript/",
    "**/dist/",
    "**/node_modules/",
    "**/*.tsbuildinfo",
    "apps/worker/worker-configuration.d.ts",
    "bun.lock"
  ]
}
