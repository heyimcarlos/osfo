# Minimal local development configuration. `bun run db:up` starts this
# PostgreSQL instance and Drizzle Kit applies pending migrations through
# `bun run db:migrate`.
OSFO_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/osfo_lifecycle
# Supported immutable profiles:
# - oz.deterministic.v1
# - oz.openai.gpt-4.1-mini-2025-04-14.responses.v1 (also requires OPENAI_API_KEY)
OSFO_EXECUTION_PROFILE_REF=oz.deterministic.v1
OSFO_GLOBAL_NON_TERMINAL_LIMIT=8
OSFO_PRINCIPAL_NON_TERMINAL_LIMIT=4
OSFO_ADMISSION_CAPACITY_RECONCILIATION_INTERVAL_MS=30000
OSFO_ADMISSION_DATABASE_POOL_MAX=4
OSFO_RESUME_DATABASE_POOL_MAX=4
OSFO_MAX_STREAM_BUFFERED_AGE_MS=5000
OSFO_MAX_STREAM_BUFFERED_BYTES=1048576
OSFO_MAX_STREAM_BUFFERED_EVENTS=64
OSFO_MAX_STREAM_CONNECTION_LIFETIME_MS=1800000
OSFO_MAX_STREAM_CONNECTIONS=64
OSFO_CURSOR_SECRET=local-reference-cursor-secret-change-in-production
OSFO_REPLAY_EVENT_LIMIT=1000
OSFO_REPLAY_GUARANTEED_FOR_MS=30000
OSFO_SNAPSHOT_TIMELINE_LIMIT=100
OSFO_STREAM_POLL_INTERVAL_MS=100
OSFO_RELAY_DATABASE_POOL_MAX=4
OSFO_RELAY_ID=osfo-local-relay
OSFO_RELAY_LEASE_DURATION_MS=30000
OSFO_RELAY_PUBLICATION_WINDOW_SIZE=128
OSFO_RELAY_PUBLISHER_CONCURRENCY=4
OSFO_RELAY_SAFETY_DRAIN_INTERVAL_MS=1000
OSFO_PUBSUB_PROJECT_ID=replace-with-project-id
OSFO_PUBSUB_TOPIC_ID=replace-with-topic-id
OSFO_WEB_PROXY_ORIGIN=http://127.0.0.1:3000
VITE_OSFO_THREAD_ID=6ef239bd-3f04-4c77-8976-1171e75ea0ab
VITE_OSFO_AUTHENTICATION_TOKEN=osfo-local-reference-session

# Required for the Cloud SQL and artifact evidence lane. Authentication comes
# from the existing gcloud or Application Default Credentials session.
GOOGLE_CLOUD_PROJECT=replace-with-project-id
GOOGLE_CLOUD_REGION=northamerica-northeast2
OSFO_CLOUD_SQL_INSTANCE=replace-with-instance-name
OSFO_CLOUD_SQL_IAM_USER=replace-with-iam-database-user
OSFO_ARTIFACT_BUCKET=replace-with-globally-unique-bucket-name
OSFO_COMPUTE_REGION=northamerica-northeast2
OSFO_CLOUD_SQL_REGION=northamerica-northeast2
OSFO_DATABASE_PROFILE="Cloud SQL PostgreSQL same-region confirmation"
OSFO_CLOUD_SQL_VERSION=POSTGRES_17

# Disposable same-region confirmation compute. These are resource names and
# shapes, never credentials. The provisioning script records exact resolved
# machine and database configuration in the evidence bundle.
OSFO_RUNNER_INSTANCE=osfo-issue-13-runner
OSFO_RUNNER_ZONE=northamerica-northeast2-a
OSFO_RUNNER_MACHINE_TYPE=replace-with-fixed-machine-type
OSFO_CLOUD_SQL_TIER=replace-with-cloud-sql-tier

# Use the local URL for Docker Compose tests. For Cloud SQL, point this at the
# local Cloud SQL Auth Proxy listener. Never commit a password-bearing URL.
OSFO_TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/osfo_lifecycle
OSFO_CLOUD_DATABASE_URL=postgres://replace-with-iam-user@127.0.0.1:55433/osfo_lifecycle
# Deployed services replace the local OSFO_DATABASE_URL above with their runtime
# DSN. Prefer private IP or the Cloud SQL connector. Never commit a
# password-bearing production value.
# PostgreSQL exporter DSN through the Cloud SQL Auth Proxy. URL-encode `@`
# characters in the IAM database username. This value contains no password.
OSFO_CLOUD_EXPORTER_DSN=postgresql://replace-with-url-encoded-iam-user@host.docker.internal:55432/osfo_lifecycle?sslmode=disable

# Temporal Cloud is the only orchestration service. Set the endpoint, namespace,
# and API key only in the untracked .env file. Osfo-hosted Rust workers execute
# workflow and Activity code. Temporal Cloud owns only workflow history.
TEMPORAL_ADDRESS=replace-with-namespace-endpoint.tmprl.cloud:7233
TEMPORAL_NAMESPACE=replace-with-namespace-id
TEMPORAL_TASK_QUEUE=osfo-agent-run-lifecycle-cloud-v1
TEMPORAL_API_KEY=
# Record these non-secret Cloud facts in each evidence bundle.
OSFO_TEMPORAL_CLOUD_REGION=gcp-us-east4
OSFO_TEMPORAL_CLOUD_CAPACITY_MODE=on-demand
OSFO_TEMPORAL_CLOUD_ACTION_LIMIT=500
TEMPORAL_TLS_SERVER_NAME=
# Separate Metrics Read-Only service-account key. Materialize it into the file
# below without printing it, then keep that file outside the repository with
# mode 0400 and owner UID/GID 65534 for the pinned Prometheus container.
# Prometheus reads only the file.
TEMPORAL_METRICS_ACCOUNT_API_KEY=
TEMPORAL_METRICS_API_KEY_FILE=/absolute/path/to/temporal-metrics-api-key
TEMPORAL_TLS_CLIENT_CERT_PATH=
TEMPORAL_TLS_CLIENT_KEY_PATH=
# Prefer file paths. Use the data variables only when the runtime requires
# in-memory certificate material, and never put their values in this example.
TEMPORAL_TLS_CLIENT_CERT_DATA=
TEMPORAL_TLS_CLIENT_KEY_DATA=

# Local protocol sinks and artifact-compatible storage.
MAILPIT_SMTP_HOST=127.0.0.1
MAILPIT_SMTP_PORT=1025
MAILPIT_API_URL=http://127.0.0.1:8025
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=osfo-lifecycle-local

# Pinned deterministic fixture configuration.
OSFO_TEST_SEED=130013
OSFO_SANDBOX_IMAGE=alpine:3.22.1@sha256:4bcff63911fcb4448bd4fdacec207030997caf25e9bea4045fa6c8c44de311d1
OSFO_EVIDENCE_MANIFEST=prototypes/agent-run-lifecycle/config/evidence-open-arrival.json
OSFO_CONFIRMATION_MANIFEST=prototypes/agent-run-lifecycle/config/issue-13-confirmation.json
# Set a new immutable UTC-based ID for every confirmation attempt.
OSFO_RUN_ID=replace-with-unique-run-id
OSFO_EVIDENCE_DIR=prototypes/agent-run-lifecycle/evidence/latest
OSFO_METRICS_ADDRESS=0.0.0.0:9464
OSFO_TEMPORAL_METRICS_ADDRESS=0.0.0.0:9465
OSFO_TEMPORAL_WORKER_FLEET_ID=osfo-temporal-cloud-worker
OSFO_TEMPORAL_WORKER_SLOTS=32
OSFO_TEMPORAL_CLIENT_ID=osfo-deployed-smoke-client
OSFO_TEMPORAL_SMOKE_WORKFLOW_ID=
OSFO_TEMPORAL_SMOKE_OUTPUT=prototypes/agent-run-lifecycle/evidence/temporal-cloud-smoke.json
# Actual Temporal Cloud workflow load, derived from the measured Luna amplification.
OSFO_TEMPORAL_LOAD_ARRIVAL_PATTERN=uniform
OSFO_TEMPORAL_LOAD_RATE_PER_SECOND=83
OSFO_TEMPORAL_LOAD_DURATION_SECONDS=15
OSFO_TEMPORAL_LOAD_COUNT=
OSFO_TEMPORAL_LOAD_TIMEOUT_SECONDS=120
OSFO_TEMPORAL_LOAD_WORKFLOW_PREFIX=
OSFO_TEMPORAL_LOAD_OUTPUT=prototypes/agent-run-lifecycle/evidence/temporal-cloud-load/results.json
OSFO_TEMPORAL_WORKER_POOL=osfo-temporal-cloud-worker
OSFO_TEMPORAL_WORKER_INSTANCES=2
OSFO_TEMPORAL_WORKER_IMAGE=replace-with-artifact-registry-image-at-digest
OSFO_TEMPORAL_API_KEY_SECRET_NAME=osfo-temporal-api-key
# Non-secret Secret Manager version number. Do not use latest for deployed evidence.
OSFO_TEMPORAL_API_KEY_SECRET_VERSION=replace-with-version-number
OSFO_TEMPORAL_METRICS_API_KEY_SECRET_NAME=osfo-temporal-metrics-account-api-key
OSFO_OPENAI_API_KEY_SECRET_NAME=osfo-openai-api-key
OSFO_E2B_API_KEY_SECRET_NAME=osfo-e2b-api-key
# Use disabled only for the Temporal-only deployment conformance lane.
# The mixed sandbox lane must use a real SandboxProvider such as E2B.
OSFO_SANDBOX_PROVIDER=disabled
# Temporal Cloud publishes completed one-minute windows after a short delay.
# The acceptance default is 210 seconds. Override only for non-acceptance diagnostics.
OSFO_TEMPORAL_CLOUD_METRICS_SETTLE_SECONDS=210
# Fail before load if any required Prometheus target remains unhealthy.
OSFO_TELEMETRY_PREFLIGHT_TIMEOUT_SECONDS=90
# The production-shaped worker fleet opens many database and telemetry sockets.
# The runner command must raise its soft file-descriptor limit to at least this.
OSFO_MIN_NOFILE=4096
OSFO_PROMETHEUS_URL=http://127.0.0.1:9090
OSFO_GRAFANA_URL=http://127.0.0.1:3000
OSFO_FOCUSED_WORKFLOWS=20

# Authenticated message ingress and direct Cloud SQL dispatch. Send the token in
# X-Osfo-Ingress-Token because Cloud Run reserves Authorization for platform IAM.
# The bearer token
# is scoped to the configured demo account and belongs only in untracked .env
# or Secret Manager. Never include it in evidence or deployment output.
OSFO_INGRESS_ACCOUNT_ID=replace-with-demo-account-id
OSFO_INGRESS_BEARER_TOKEN=
OSFO_INGRESS_DATABASE_POOL_SIZE=16
OSFO_AGENT_RUN_WORKER_DATABASE_POOL_SIZE=32
OSFO_AGENT_RUN_WORKER_ID=replace-with-worker-fleet-id
OSFO_AGENT_RUN_EMPTY_POLL_MILLISECONDS=25
OSFO_AGENT_RUN_WORKER_CONCURRENCY=32

# Candidate A deployment identities and immutable image reference.
OSFO_DEPLOY_REGION=northamerica-northeast2
OSFO_RUNTIME_IMAGE=replace-with-artifact-registry-image-at-digest
OSFO_RUNTIME_SERVICE_ACCOUNT=osfo-runtime@replace-with-project-id.iam.gserviceaccount.com
OSFO_RUNTIME_DB_IAM_USER=osfo-runtime@replace-with-project-id.iam
OSFO_CLOUD_SQL_CONNECTION_NAME=replace-with-project-id:northamerica-northeast2:replace-with-instance
OSFO_INGRESS_SERVICE=osfo-ingress
OSFO_STREAM_SERVICE=osfo-stream
OSFO_AGENT_RUN_WORKER_POOL=osfo-agent-run-worker
OSFO_AGENT_RUN_WORKER_INSTANCES=2
OSFO_AGENT_RUN_WORKER_DATABASE_POOL_SIZE=8
OSFO_AGENT_RUN_WORKER_CONCURRENCY=16
OSFO_INGRESS_MIN_INSTANCES=4
OSFO_INGRESS_MAX_INSTANCES=12
OSFO_INGRESS_CONCURRENCY=16
OSFO_INGRESS_DATABASE_POOL_SIZE=4
OSFO_STREAM_MIN_INSTANCES=2
OSFO_STREAM_MAX_INSTANCES=8
OSFO_STREAM_CONCURRENCY=500
OSFO_STREAM_DATABASE_POOL_SIZE=4
OSFO_INGRESS_SECRET_NAME=osfo-ingress-bearer-token
# Optional non-secret Secret Manager version number. Pin deployed revisions when known.
OSFO_INGRESS_SECRET_VERSION=latest

# External incoming-message load generator. Use an immutable UTC output path
# for each lane and pass the bearer token only through the local environment.
OSFO_LOAD_BASE_URL=https://replace-with-ingress-service-url
OSFO_LOAD_STREAM_BASE_URL=https://replace-with-stream-service-url
OSFO_LOAD_SCENARIO=steady-23
# basic isolates ingress and direct AgentRun dispatch. luna-discovery replays the
# measured OpenRouter reasoning distribution. issue13 remains the older fixture.
OSFO_LOAD_JOURNEY_PROFILE=luna-discovery
# Optional focused conformance override, for example child-fanout.
OSFO_LOAD_JOURNEY_OVERRIDE=
# uniform, linear-ramp, burst, or idle-to-burst. Burst patterns offer the
# configured rate multiplied by duration at one instant.
OSFO_LOAD_ARRIVAL_PATTERN=uniform
OSFO_LOAD_RATE_PER_SECOND=23
# Required only for linear-ramp, and must be lower than the target rate.
OSFO_LOAD_START_RATE_PER_SECOND=
OSFO_LOAD_DURATION_SECONDS=60
# Used only by idle-to-burst to prove wake-up behavior after an idle period.
OSFO_LOAD_IDLE_SECONDS=30
OSFO_LOAD_MAXIMUM_IN_FLIGHT=2048
OSFO_LOAD_COMPLETION_TIMEOUT_SECONDS=60
# Optional PEM root certificate for a test-only self-managed HTTPS frontend.
OSFO_LOAD_CA_CERT_PATH=
OSFO_LOAD_OUTPUT_DIR=prototypes/agent-run-lifecycle/evidence/deployed-load-latest

# Inputs for one self-contained deployed evidence dashboard. These are paths to
# sanitized evidence files, never credentials or raw provider responses.
OSFO_DEPLOYED_RESULT_FILES=
OSFO_REASONING_DISCOVERY_RESULT=
OSFO_TEMPORAL_RESULT_FILES=
OSFO_AUXILIARY_EVIDENCE_FILES=
OSFO_COST_RESULT=
OSFO_DEPLOYED_DASHBOARD_OUTPUT=prototypes/agent-run-lifecycle/evidence/deployed-dashboard

# Diagnostic-only overrides. Never set OSFO_DIAGNOSTIC_MODE for an acceptance
# run because the machine verdict deliberately marks diagnostic evidence
# MISSING.
OSFO_DIAGNOSTIC_MODE=
OSFO_STAGE_FILTER=
OSFO_STAGE_DURATION_OVERRIDE_SECONDS=
OSFO_WORKER_OVERRIDE=
OSFO_MAX_DRAIN_SECONDS=1800

# Optional conformance lanes. Leave blank until the corresponding smoke test
# is explicitly selected. Values belong only in the untracked .env file.
OPENAI_API_KEY=
OSFO_OPENAI_MODEL=gpt-5-mini
# Optional focused Rig conformance lane. Keep the real value only in `.env`.
OPENROUTER_API_KEY=
OSFO_OPENROUTER_MODEL=openai/gpt-5.6-luna
E2B_API_KEY=
OSFO_E2B_EVIDENCE_FILE=prototypes/agent-run-lifecycle/evidence/e2b-focused/e2b-smoke.json
DAYTONA_API_KEY=
DAYTONA_API_URL=
