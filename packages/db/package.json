{
  "name": "@osfo/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "development": "./src/testing.ts",
      "default": "./dist/testing.js"
    },
    "./reference-client": {
      "types": "./dist/reference-client.d.ts",
      "development": "./src/reference-client.ts",
      "default": "./dist/reference-client.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "db:check": "drizzle-kit check --config=drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=drizzle.config.ts",
    "test": "vitest run --exclude '**/*.postgres.test.ts' --exclude '**/.typescript/**' --exclude '**/dist/**'",
    "test:postgres": "vitest run test/message-admission.postgres.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/sql-pg": "catalog:",
    "@osfo/api": "workspace:*",
    "@osfo/session": "workspace:*",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
