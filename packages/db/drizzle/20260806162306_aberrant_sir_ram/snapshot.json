      "schema": "public",
      "table": "thread_events"
    },
    {
      "value": "jsonb_typeof(\"payload\" -> 'content') = 'array'\n        AND jsonb_array_length(\"payload\" -> 'content') = 1\n        AND (\"payload\" -> 'content' -> 0) = jsonb_build_object(\n          'type', 'text',\n          'text', \"payload\" -> 'content' -> 0 ->> 'text'\n        )\n        AND length(\"payload\" -> 'content' -> 0 ->> 'text') BETWEEN 1 AND 16384",
      "name": "thread_events_payload_content_check",
