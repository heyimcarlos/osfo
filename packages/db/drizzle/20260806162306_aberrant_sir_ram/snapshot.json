    },
    {
      "value": "\"payload\" = jsonb_build_object(\n        'userMessageId', \"payload\" ->> 'userMessageId',\n        'agentRunId', \"payload\" ->> 'agentRunId',\n        'content', \"payload\" -> 'content'\n      )",
      "name": "thread_events_payload_shape_check",
