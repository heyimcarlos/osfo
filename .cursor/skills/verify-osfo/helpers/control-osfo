#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd -- "$script_dir/../../../.." && pwd)"
state_parent="${TMPDIR:-/tmp}/osfo-verification"
artifact_parent="$repo_root/artifacts/verification/osfo"

usage() {
  printf '%s\n' \
    'Usage:' \
    '  control-osfo start <run-id>' \
    '  control-osfo doctor <run-id>' \
    '  control-osfo doctor-live' \
    '  control-osfo drive <run-id> <registration|billing-checkout>' \
    '  control-osfo drive-live <run-id> memory-correction' \
    '  control-osfo cleanup <run-id>'
}

require_run_id() {
  local run_id="${1:-}"
  if [[ ! "$run_id" =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$ ]]; then
    printf 'Invalid run ID: %s\n' "$run_id" >&2
    exit 2
  fi
}

state_dir_for() {
  printf '%s/%s\n' "$state_parent" "$1"
}

artifact_dir_for() {
  printf '%s/%s\n' "$artifact_parent" "$1"
}

read_state() {
  local run_id="$1"
  local state_dir
  state_dir="$(state_dir_for "$run_id")"
  if [[ ! -s "$state_dir/container-id" || ! -s "$state_dir/postgres-port" ]]; then
    printf 'No active verification state for run %s\n' "$run_id" >&2
    exit 1
  fi
  container_id="$(<"$state_dir/container-id")"
  postgres_port="$(<"$state_dir/postgres-port")"
}

doctor_tools() {
  command -v bun >/dev/null
  command -v node >/dev/null
  command -v docker >/dev/null
  if [[ "$(bun --version)" != '1.3.14' ]]; then
    printf 'Expected Bun 1.3.14, found %s\n' "$(bun --version)" >&2
    exit 1
  fi
  if [[ "$(node --version)" != 'v24.18.0' ]]; then
    printf 'Expected Node v24.18.0, found %s\n' "$(node --version)" >&2
    exit 1
  fi
  if [[ ! -x "$repo_root/node_modules/.bin/vitest" ]]; then
    printf 'Vitest is missing. Run bun install --frozen-lockfile.\n' >&2
    exit 1
  fi
}

doctor_run() {
  local run_id="$1"
  doctor_tools
  read_state "$run_id"
  if [[ "$(docker inspect --format '{{.State.Running}}' "$container_id" 2>/dev/null)" != 'true' ]]; then
    printf 'PostgreSQL container is not running for run %s\n' "$run_id" >&2
    exit 1
  fi
  local run_label
  run_label="$(docker inspect --format '{{ index .Config.Labels "osfo.verification.run" }}' "$container_id")"
  if [[ "$run_label" != "$run_id" ]]; then
    printf 'Container label mismatch for run %s\n' "$run_id" >&2
    exit 1
  fi
  docker exec "$container_id" pg_isready --dbname postgres --username osfo >/dev/null
  printf 'healthy run=%s container=%s postgres_port=%s commit=%s\n' \
    "$run_id" "$container_id" "$postgres_port" "$(git -C "$repo_root" rev-parse HEAD)"
}

start_run() {
  local run_id="$1"
  doctor_tools
  local state_dir artifact_dir container_name container_id mapping postgres_port
  state_dir="$(state_dir_for "$run_id")"
  artifact_dir="$(artifact_dir_for "$run_id")"
  container_name="osfo-verify-postgres-$run_id"
  if [[ -e "$state_dir" ]]; then
    printf 'Run state already exists: %s\n' "$state_dir" >&2
    exit 1
  fi
  mkdir -p "$state_dir" "$artifact_dir"
  container_id="$(docker run --detach \
    --env POSTGRES_DB=postgres \
    --env POSTGRES_PASSWORD=osfo \
    --env POSTGRES_USER=osfo \
    --label "osfo.verification.run=$run_id" \
    --name "$container_name" \
    --publish 127.0.0.1::5432 \
    postgres:17)"
  printf '%s\n' "$container_id" >"$state_dir/container-id"

  for attempt in {1..30}; do
    if docker exec "$container_id" pg_isready --dbname postgres --username osfo >/dev/null 2>&1; then
      break
    fi
    if [[ "$attempt" == '30' ]]; then
      printf 'PostgreSQL did not become ready for run %s\n' "$run_id" >&2
      exit 1
    fi
    sleep 1
  done

  mapping="$(docker port "$container_id" 5432/tcp)"
  postgres_port="${mapping##*:}"
  printf '%s\n' "$postgres_port" >"$state_dir/postgres-port"
  printf 'ready run=%s container=%s postgres_port=%s\n' "$run_id" "$container_id" "$postgres_port"
}

recorded_drive() {
  local run_id="$1"
  local feature="$2"
  local source_file="$3"
  shift 3
  local artifact_dir transcript_path exit_code
  artifact_dir="$(artifact_dir_for "$run_id")"
  transcript_path="$artifact_dir/transcript.log"
  mkdir -p "$artifact_dir"
  cp "$source_file" "$artifact_dir/journey-source.ts"
  printf 'run_id=%s\nfeature=%s\nstarted_at=%s\ncommit=%s\ncommand=' \
    "$run_id" "$feature" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$(git -C "$repo_root" rev-parse HEAD)" \
    >"$artifact_dir/metadata.txt"
  printf '%q ' "$@" >>"$artifact_dir/metadata.txt"
  printf '\n' >>"$artifact_dir/metadata.txt"

  set +e
  "$@" 2>&1 | tee "$transcript_path"
  exit_code="${PIPESTATUS[0]}"
  set -e
  if [[ "$exit_code" == '0' ]] &&
    grep --quiet --extended-regexp \
      'DNS lookup failed|uncaught exception|dash\.better-auth\.com' \
      "$transcript_path"; then
    printf 'Unexpected external dependency or runtime failure found in transcript.\n' | tee -a "$transcript_path"
    exit_code=1
  fi
  printf 'exit_code=%s\ncompleted_at=%s\n' \
    "$exit_code" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$artifact_dir/result.txt"
  if [[ "$exit_code" != '0' ]]; then
    printf 'Drive failed. Evidence retained at %s\n' "$artifact_dir" >&2
    return "$exit_code"
  fi
  printf 'verified feature=%s evidence=%s\n' "$feature" "$artifact_dir"
}

drive_composed() {
  local run_id="$1"
  local feature="$2"
  doctor_run "$run_id"
  read_state "$run_id"
  local test_file
  case "$feature" in
    registration)
      test_file='test/journeys/registration.test.ts'
      ;;
    billing-checkout)
      test_file='test/journeys/billing.test.ts'
      ;;
    *)
      printf 'Unknown composed feature: %s\n' "$feature" >&2
      exit 2
      ;;
  esac
  local postgres_url="postgres://osfo:osfo@127.0.0.1:$postgres_port/postgres"
  recorded_drive \
    "$run_id" \
    "$feature" \
    "$repo_root/apps/worker/$test_file" \
    env --chdir="$repo_root/apps/worker" OSFO_TEST_POSTGRES_URL="$postgres_url" \
    bun x vitest run "$test_file" \
    --config vitest.journeys.config.ts --reporter verbose
}

doctor_live() {
  doctor_tools
  local env_file="$repo_root/apps/worker/.env"
  if [[ ! -s "$env_file" ]]; then
    printf 'Missing apps/worker/.env\n' >&2
    exit 1
  fi
  if ! grep --quiet --extended-regexp '^SUPERMEMORY_API_KEY=.+$' "$env_file"; then
    printf 'SUPERMEMORY_API_KEY is missing from apps/worker/.env\n' >&2
    exit 1
  fi
  printf 'healthy live_credentials=present commit=%s\n' "$(git -C "$repo_root" rev-parse HEAD)"
}

drive_live() {
  local run_id="$1"
  local feature="$2"
  doctor_live
  if [[ "$feature" != 'memory-correction' ]]; then
    printf 'Unknown live feature: %s\n' "$feature" >&2
    exit 2
  fi
  recorded_drive \
    "$run_id" \
    "$feature" \
    "$repo_root/apps/worker/test/live/supermemory-qualification.live.test.ts" \
    env --chdir="$repo_root/apps/worker" \
    bun --env-file=.env --bun x vitest run \
    --config vitest.live.config.ts --reporter verbose
}

cleanup_run() {
  local run_id="$1"
  local state_dir container_id run_label
  state_dir="$(state_dir_for "$run_id")"
  if [[ ! -e "$state_dir" ]]; then
    printf 'No active state to clean for run %s\n' "$run_id"
    return 0
  fi
  if [[ ! -s "$state_dir/container-id" ]]; then
    rm -r "$state_dir"
    printf 'cleaned partial run=%s evidence=%s\n' "$run_id" "$(artifact_dir_for "$run_id")"
    return 0
  fi
  container_id="$(<"$state_dir/container-id")"
  if ! docker inspect "$container_id" >/dev/null 2>&1; then
    rm -r "$state_dir"
    printf 'cleaned stopped run=%s evidence=%s\n' "$run_id" "$(artifact_dir_for "$run_id")"
    return 0
  fi
  run_label="$(docker inspect --format '{{ index .Config.Labels "osfo.verification.run" }}' "$container_id" 2>/dev/null || true)"
  if [[ "$run_label" != "$run_id" ]]; then
    printf 'Refusing to remove container with mismatched run label for %s\n' "$run_id" >&2
    exit 1
  fi
  docker rm --force "$container_id" >/dev/null
  rm -r "$state_dir"
  printf 'cleaned run=%s evidence=%s\n' "$run_id" "$(artifact_dir_for "$run_id")"
}

command_name="${1:-help}"
case "$command_name" in
  start)
    require_run_id "${2:-}"
    start_run "$2"
    ;;
  doctor)
    require_run_id "${2:-}"
    doctor_run "$2"
    ;;
  doctor-live)
    doctor_live
    ;;
  drive)
    require_run_id "${2:-}"
    drive_composed "$2" "${3:-}"
    ;;
  drive-live)
    require_run_id "${2:-}"
    drive_live "$2" "${3:-}"
    ;;
  cleanup)
    require_run_id "${2:-}"
    cleanup_run "$2"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
