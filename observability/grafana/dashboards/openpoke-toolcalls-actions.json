                        "index": 0,
                        "text": "PASS"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "mode": "basic",
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "classification"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "contextual": {
                        "color": "semi-dark-blue",
                        "index": 2,
                        "text": "CONTEXT"
                      },
                      "current": {
                        "color": "text",
                        "index": 0,
                        "text": "CURRENT"
                      },
                      "derived": {
                        "color": "semi-dark-blue",
                        "index": 3,
                        "text": "DERIVED"
                      },
                      "historical": {
                        "color": "blue",
                        "index": 1,
