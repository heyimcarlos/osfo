      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "FAIL": {
                        "color": "red",
                        "index": 1,
                        "text": "FAIL"
                      },
                      "MISSING": {
                        "color": "gray",
                        "index": 2,
                        "text": "MISSING"
                      },
