          "editorMode": "code",
          "expr": "openpoke_catalog_requirement_status{issue=~\"$issue\",requirement=~\"(?i).*(action|provider|idempotency|lost.ack|toolcall).*\"}",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A",
          "format": "table"
        }
      ],
