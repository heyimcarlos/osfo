    {
      "id": 8,
      "title": "Execution profile and image",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "openpoke-prometheus"
      },
      "description": "Exact sanitized provider profile and model binding. The image digest stays MISSING until a safe current digest is captured.",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "FAIL": {
                        "color": "red",
