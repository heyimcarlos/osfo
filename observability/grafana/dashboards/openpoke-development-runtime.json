    {
      "id": 2,
      "title": "Runtime smoke",
      "description": "Sanitized development runtime result.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "openpoke-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "color": "red",
                  "index": 1,
                  "text": "FAIL"
                },
                "1": {
                  "color": "green",
                  "index": 0,
                  "text": "PASS"
                },
                "-1": {
                  "color": "gray",
                  "index": 2,
                  "text": "MISSING"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray",
                "value": null
              },
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "openpoke-prometheus"
          },
          "editorMode": "code",
          "expr": "max(openpoke_catalog_status{environment=\"development\",gate=\"runtime_smoke\"}) or on() vector(-1)",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ]
    },
