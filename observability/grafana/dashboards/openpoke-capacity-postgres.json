        "x": 0,
        "y": 4,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "color": "red",
                  "index": 1,
                  "text": "FAIL"
                },
                "1": {
                  "color": "green",
                  "index": 0,
                  "text": "PASS"
                },
