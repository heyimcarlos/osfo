{
  "name": "osfo-workspace",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run db:check",
    "db:check": "bun run --cwd packages/db db:check",
    "db:down": "docker compose -f compose.postgres.yaml down --volumes",
    "db:generate": "bun run --cwd packages/db db:generate",
    "db:migrate": "bun run --env-file=.env --cwd packages/db db:migrate",
    "db:seed:reference": "node --env-file=.env --conditions=development --import tsx scripts/seed-reference-client.ts",
    "db:studio": "bun run --env-file=.env --cwd packages/db db:studio",
    "db:up": "docker compose -f compose.postgres.yaml up -d --wait",
    "db:verify": "bash scripts/verify-migrations.sh",
    "demo:evidence:cards": "bun observability/render-demo-evidence-cards.ts docs/openpoke-v1-demo/artifact-index.json",
    "demo:evidence:three-tab": "bash observability/capture-three-tab-evidence.sh docs/openpoke-v1-demo/artifact-index.json \"${OSFO_THREE_TAB_OUTPUT_DIR:?OSFO_THREE_TAB_OUTPUT_DIR is required}\"",
    "demo:evidence:verify": "bun observability/demo-packet-verifier.ts docs/openpoke-v1-demo/artifact-index.json",
    "dev": "bun run --env-file=.env turbo run dev",
    "dev:web": "turbo run dev --filter=@osfo/web",
    "format": "oxfmt .oxfmtrc.json package.json turbo.json tsconfig.json tsconfig.scripts.json tsconfig.infra.json compose.postgres.yaml README.md apps packages scripts infra observability .github",
    "format:check": "oxfmt --check .oxfmtrc.json package.json turbo.json tsconfig.json tsconfig.scripts.json tsconfig.infra.json compose.postgres.yaml README.md apps packages scripts infra observability .github",
    "infra:check": "terraform fmt -check -recursive infra && bash infra/tests/policy.sh && bash infra/tests/repository-contract.sh && bash infra/scripts/check-source.sh infra",
    "infra:test": "vitest run infra/test/terraform-foundation.test.ts --exclude '**/.worktrees/**'",
    "lint": "oxlint --deny-warnings .",
    "observability:compose:check": "docker compose --file observability/compose.yaml config --quiet",
    "observability:test": "vitest run observability/*.test.ts",
    "observability:typecheck": "tsc --project observability/tsconfig.json",
    "start:agent-run-worker": "bun run --cwd apps/agent-run-worker start",
    "start:outbox-relay": "bun run --cwd apps/outbox-relay start",
    "start:ingress": "bun run --cwd apps/ingress start",
    "test": "bun run infra:test && bun run observability:test && turbo run test",
    "typecheck": "tsc --project tsconfig.scripts.json && tsc --project tsconfig.infra.json && bun run observability:typecheck && turbo run typecheck"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@osfo/db": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/language-service": "0.85.1",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "0.44.0",
    "oxlint": "1.56.0",
    "tsx": "catalog:",
    "turbo": "2.9.18",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "24.18.0"
  },
  "packageManager": "bun@1.3.14",
  "catalog": {
    "@effect/atom-react": "4.0.0-beta.103",
    "@effect/platform-node": "4.0.0-beta.103",
    "@effect/sql-pg": "4.0.0-beta.103",
    "@effect/vitest": "4.0.0-beta.103",
    "@tailwindcss/vite": "4.2.2",
    "@types/node": "24.3.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "@types/pg": "8.20.4",
    "drizzle-kit": "1.0.0-rc.4",
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "4.0.0-beta.103",
    "lucide-react": "1.24.0",
    "pg": "8.22.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "tailwindcss": "4.2.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.0.8",
    "vitest": "4.1.5"
  }
}
