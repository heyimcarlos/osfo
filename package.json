{
  "name": "osfo-workspace",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --cwd packages/ui build && bun run --cwd apps/web build",
    "dev": "bun run --cwd apps/web dev",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "test": "vitest run tools/oxlint/test && bun run --cwd packages/ui test && bun run --cwd apps/web test",
    "typecheck": "tsc --project tools/oxlint/tsconfig.json && bun run --cwd packages/ui typecheck && bun run --cwd apps/web typecheck"
  },
  "devDependencies": {
    "@effect/tsgo": "0.36.4",
    "@effect/vitest": "catalog:",
    "@oxlint/plugins": "1.77.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "effect": "catalog:",
    "oxfmt": "0.44.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "24.18.0"
  },
  "packageManager": "bun@1.3.14",
  "catalog": {
    "@effect/vitest": "4.0.0-beta.103",
    "@tailwindcss/vite": "4.2.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/node": "24.13.3",
    "@vitejs/plugin-react": "6.0.1",
    "effect": "4.0.0-beta.103",
    "lucide-react": "1.24.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "tailwindcss": "4.2.2",
    "typescript": "7.0.2",
    "vite": "8.0.8",
    "vitest": "4.1.5"
  }
}
