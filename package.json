{
  "name": "osfo-workspace",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "db:down": "docker compose -f compose.postgres.yaml down --volumes",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:up": "docker compose -f compose.postgres.yaml up -d --wait",
    "db:verify": "bash scripts/verify-migrations.sh",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@osfo/web",
    "format": "oxfmt .oxfmtrc.json package.json turbo.json tsconfig.json tsconfig.scripts.json compose.postgres.yaml README.md apps packages scripts migrations",
    "format:check": "oxfmt --check .oxfmtrc.json package.json turbo.json tsconfig.json tsconfig.scripts.json compose.postgres.yaml README.md apps packages scripts migrations",
    "lint": "oxlint --deny-warnings .",
    "start:agent-run-worker": "bun run --cwd apps/agent-run-worker start",
    "start:native-thread-transport": "bun run --cwd apps/native-thread-transport start",
    "test": "turbo run test",
    "typecheck": "tsc --project tsconfig.scripts.json && turbo run typecheck"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/sql-pg": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/language-service": "0.85.1",
    "@types/node": "catalog:",
    "oxfmt": "0.44.0",
    "oxlint": "1.56.0",
    "tsx": "catalog:",
    "turbo": "2.9.18",
    "typescript": "catalog:"
  },
  "engines": {
    "node": "24.18.0"
  },
  "packageManager": "bun@1.3.14",
  "catalog": {
    "@effect/platform-node": "4.0.0-beta.103",
    "@effect/sql-pg": "4.0.0-beta.103",
    "@tailwindcss/vite": "4.2.2",
    "@types/node": "24.3.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "effect": "4.0.0-beta.103",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "tailwindcss": "4.2.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.0.8",
    "vitest": "4.1.5"
  }
}
