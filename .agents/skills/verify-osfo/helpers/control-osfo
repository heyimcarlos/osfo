deliver_whatsapp_message() {
  local run_id message state_dir worker_origin sender payload signature response_path http_status
  run_id="$1"
  message="$2"
  state_dir="$(state_dir_for "$run_id")"
  worker_origin="$(state_value "$run_id" worker-origin)"
  sender="$(state_value "$run_id" phone-national)"
  payload="$(jq --null-input --compact-output \
    --arg sender "$sender" \
    --arg message "$message" \
    --arg messageId "wamid.verify.$(date +%s%N)" \
    --arg timestamp "$(date +%s)" \
    '{
      object: "whatsapp_business_account",
      entry: [{
        id: "verification-business",
        changes: [{
          field: "messages",
          value: {
            messaging_product: "whatsapp",
            metadata: {
              display_phone_number: "15550000000",
              phone_number_id: "123456789"
            },
            contacts: [{ profile: { name: "Verification" }, wa_id: $sender }],
            messages: [{
              from: $sender,
              id: $messageId,
              timestamp: $timestamp,
              text: { body: $message },
              type: "text"
            }]
          }
        }]
      }]
    }')"
  signature="$(printf '%s' "$payload" | \
    WHATSAPP_APP_SECRET='test-only-whatsapp-app-secret' bun -e '
      import { createHmac } from "node:crypto";
      const body = await Bun.stdin.text();
      process.stdout.write(`sha256=${createHmac("sha256", process.env.WHATSAPP_APP_SECRET).update(body).digest("hex")}`);
    ')"
  response_path="$state_dir/whatsapp-webhook-response.txt"
  http_status="$(curl --silent --show-error --max-time 90 \
    --output "$response_path" --write-out '%{http_code}' \
    --header 'content-type: application/json' \
    --header "x-hub-signature-256: $signature" \
    --data-binary "$payload" "$worker_origin/webhooks/whatsapp")"
  if [[ "$http_status" != '200' ]]; then
    printf 'WhatsApp delivery failed with HTTP %s: %s\n' \
      "$http_status" "$(<"$response_path")" >&2
    return 1
  fi
  printf 'whatsapp_delivered sender=%s\n' "$sender"
}

