channel_invite() {
  local run_id state_dir provider_origin worker_origin web_origin telegram_author
  local update_id payload response_path http_status invite_url ledger_path attempt
  run_id="$1"
  doctor_run "$run_id" >/dev/null
  state_dir="$(state_dir_for "$run_id")"
  provider_origin="$(state_value "$run_id" provider-origin)"
  worker_origin="$(state_value "$run_id" worker-origin)"
  web_origin="$(state_value "$run_id" web-origin)"
  telegram_author="$(state_value "$run_id" telegram-author)"
  update_id="$((telegram_author + 100000000))"
  payload="$(printf '{"update_id":%s,"message":{"message_id":1,"from":{"id":%s,"is_bot":false,"first_name":"Verification"},"chat":{"id":%s,"type":"private","first_name":"Verification"},"date":%s,"text":"I want to try Osfo"}}' \
    "$update_id" "$telegram_author" "$telegram_author" "$(date +%s)")"
  response_path="$state_dir/telegram-webhook-response.txt"
  http_status="$(curl --silent --show-error --max-time 90 \
    --output "$response_path" --write-out '%{http_code}' \
    --header 'content-type: application/json' \
    --header "x-telegram-bot-api-secret-token: $telegram_secret" \
    --data "$payload" "$worker_origin/webhooks/telegram")"
  if [[ "$http_status" != '200' ]]; then
    printf 'Telegram delivery failed with HTTP %s: %s\n' "$http_status" "$(<"$response_path")" >&2
    exit 1
  fi
  ledger_path="$state_dir/telegram-ledger.json"
  invite_url=''
  for attempt in {1..60}; do
    curl --fail --silent --show-error "$provider_origin/_test/telegram/ledger" | jq . >"$ledger_path"
    invite_url="$(jq --raw-output \
      '.[].body | fromjson? | (.text? // .rich_message.markdown? // empty)' "$ledger_path" \
      | grep -E -o "${web_origin//./\\.}/verify/[A-Za-z0-9_-]+" \
      | tail -n 1 || true)"
    if [[ -n "$invite_url" ]]; then
      break
    fi
    sleep 0.5
  done
  if [[ -z "$invite_url" ]]; then
    printf 'The local Telegram path produced no invitation. See %s and %s\n' \
      "$response_path" "$ledger_path" >&2
    exit 1
  fi
  printf '%s\n' "$invite_url" >"$state_dir/channel-invite-url"
  printf 'invite_ready url=%s author=%s\n' "$invite_url" "$telegram_author"
}

r2_object_exists() {
  local state_dir bucket key
  state_dir="$1"
  bucket="$2"
  key="$3"
  "$repo_root/apps/worker/node_modules/.bin/wrangler" r2 object get "$bucket/$key" \
    --config "$state_dir/wrangler.json" \
    --local \
    --persist-to "$state_dir/wrangler-state" \
    --pipe >/dev/null 2>&1
}

put_r2_object() {
  local state_dir bucket key content
  state_dir="$1"
  bucket="$2"
  key="$3"
  content="$4"
  printf '%s' "$content" \
    | "$repo_root/apps/worker/node_modules/.bin/wrangler" r2 object put "$bucket/$key" \
      --config "$state_dir/wrangler.json" \
      --force \
      --local \
      --persist-to "$state_dir/wrangler-state" \
      --pipe >/dev/null
}

require_owned_identifier() {
