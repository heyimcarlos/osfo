record_reminder_due() {
  local run_id due feature_dir normalized now_milliseconds due_milliseconds remaining
  run_id="$1"
  due="$2"
  doctor_run "$run_id" >/dev/null
  feature_dir="$(feature_artifact_dir_for "$run_id" whatsapp-wakeup)"
  if [[ ! -s "$feature_dir/metadata.txt" ]]; then
    printf 'Start whatsapp-wakeup evidence before recording the approved due time\n' >&2
    exit 1
  fi
  if [[ -e "$feature_dir/nominal-due-at.txt" ]]; then
    printf 'The one-time Reminder nominal due is already recorded\n' >&2
    exit 1
  fi
  normalized="$(bun "$script_dir/reminder-slo.mjs" normalize "$due")"
  now_milliseconds="$(($(date +%s) * 1000))"
  due_milliseconds="$(bun -e 'process.stdout.write(String(Date.parse(process.argv[1])))' "$normalized")"
  remaining="$((due_milliseconds - now_milliseconds))"
  if (( remaining < 30000 || remaining > 600000 )); then
    printf 'Approved one-time Reminder due must be 30 seconds to 10 minutes ahead; got %sms\n' \
      "$remaining" >&2
    exit 1
  fi
  printf '%s\n' "$normalized" >"$feature_dir/nominal-due-at.txt"
  printf 'reminder_due_recorded nominal_due_at=%s remaining_ms=%s\n' "$normalized" "$remaining"
}

capture_reminder_occurrence() {
  local run_id feature_dir container_id phone identity user_id agent_id runtime nominal_due_at
  local committed_at handler_slo
  run_id="$1"
  doctor_run "$run_id" >/dev/null
  feature_dir="$(feature_artifact_dir_for "$run_id" whatsapp-wakeup)"
  if [[ ! -s "$feature_dir/nominal-due-at.txt" ]]; then
    printf 'Record the approved one-time nominal due before capturing its occurrence\n' >&2
    exit 1
  fi
  if [[ -e "$feature_dir/reminder-handler-slo.json" ]]; then
    printf 'The due Reminder occurrence is already captured\n' >&2
    exit 1
  fi
  container_id="$(state_value "$run_id" container-id)"
  phone="$(state_value "$run_id" phone-e164)"
  identity="$(docker exec --env PGPASSWORD=osfo "$container_id" \
    psql --dbname osfo --username osfo --tuples-only --no-align --set=ON_ERROR_STOP=1 \
    --command "select json_build_object('userId', u.id, 'agentId', a.agent_id)
      from users u join agents a on a.user_id = u.id where u.phone_number = '$phone';")"
  if [[ -z "$identity" ]]; then
    printf 'No registered User and Agent exist for the run-owned phone\n' >&2
    exit 1
  fi
  user_id="$(jq --exit-status --raw-output '.userId' <<<"$identity")"
  agent_id="$(jq --exit-status --raw-output '.agentId' <<<"$identity")"
  require_owned_identifier 'User ID' "$user_id"
  require_owned_identifier 'Agent ID' "$agent_id"
  runtime="$(inspect_agent_runtime "$run_id" "$agent_id" "$user_id")"
  nominal_due_at="$(<"$feature_dir/nominal-due-at.txt")"
  jq --exit-status --arg due "$nominal_due_at" \
    '. as $runtime |
      [.reminderVerification.occurrences[] | select(.nominalDueAt == $due)] as $occurrences |
      $occurrences | length == 1 and
      $occurrences[0].committedAt != null and
      $occurrences[0].exposedAt == null and
      $occurrences[0].thinkPresentedAt == null and
      $occurrences[0].thinkSubmissionId == null and
      $occurrences[0].sourceRevokedAt == null and
      $runtime.reminderVerification.activeScheduleBindingCount == 0 and
      $runtime.reminderVerification.agentScheduleCount == 0' \
    <<<"$runtime" >/dev/null
  committed_at="$(jq --exit-status --raw-output --arg suffix ":$nominal_due_at" \
    '[.reminderSources[] | select(.sourceIdentity | endswith($suffix))] |
      if length == 1 then .[0].committedAt else error("expected one exact due Reminder source") end' \
    <<<"$runtime")"
  handler_slo="$(bun "$script_dir/reminder-slo.mjs" assert-handler \
    "$nominal_due_at" "$committed_at")"
  jq . <<<"$runtime" >"$feature_dir/reminder-runtime.json"
  jq . <<<"$handler_slo" >"$feature_dir/reminder-handler-slo.json"
  printf 'reminder_occurrence_captured committed_at=%s handler_elapsed_ms=%s\n' \
    "$committed_at" "$(jq --raw-output '.elapsedMilliseconds' <<<"$handler_slo")"
}

