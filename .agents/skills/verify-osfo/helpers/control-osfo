  ')"
  attempt_key="${artifact_key/client-content\//document-attempts/}"
  owner_key="document-owners/by-user/$(VERIFICATION_PART="$user_id" bun -e 'process.stdout.write(encodeURIComponent(process.env.VERIFICATION_PART))')/${artifact_key#client-content/}"
  if r2_object_exists "$state_dir" "$files_bucket" "$source_key"; then source_exists=true; else source_exists=false; fi
  if r2_object_exists "$state_dir" "$artifacts_bucket" "$artifact_key"; then artifact_exists=true; else artifact_exists=false; fi
  if r2_object_exists "$state_dir" "$artifacts_bucket" "$attempt_key"; then attempt_exists=true; else attempt_exists=false; fi
  if r2_object_exists "$state_dir" "$artifacts_bucket" "$owner_key"; then owner_exists=true; else owner_exists=false; fi
  jq --null-input \
    --arg actionId "$action_id" \
    --arg workflowId "$workflow_id" \
    --argjson postgres "$state_json" \
    --argjson runtime "$runtime" \
    --argjson sourceExists "$source_exists" \
    --argjson artifactExists "$artifact_exists" \
    --argjson attemptExists "$attempt_exists" \
    --argjson ownerExists "$owner_exists" \
    '$postgres + { actionId: $actionId, workflowId: $workflowId,
      agentRuntime: $runtime, sourceExists: $sourceExists,
      artifactExists: $artifactExists, attemptExists: $attemptExists,
      ownerExists: $ownerExists }' >"$feature_dir/state.json"
  model_ledger="$(curl --fail --silent --show-error \
    "$provider_origin/_test/research/ledger" | jq --argjson before "$before_model_count" '.[ $before: ]')"
  jq --null-input \
    --arg actionId "$action_id" \
    --arg agentReply "$(<"$feature_dir/agent-reply.txt")" \
    --arg agentRequest "$(<"$feature_dir/agent-request.txt")" \
    --argjson model "$model_ledger" \
    --argjson telegram "$(curl --fail --silent --show-error "$provider_origin/_test/telegram/ledger")" \
    '{ actionId: $actionId, agentReply: $agentReply, agentRequest: $agentRequest,
      model: $model, telegram: $telegram }' >"$feature_dir/provider.json"
  "$script_dir/assert-document-build-free-state" \
    "$feature_dir/state.json" "$user_id" "$file_id"
  jq --exit-status \
    --arg actionId "$action_id" --arg fileId "$file_id" \
    '. as $provider |
      .actionId == $actionId and
      .agentReply == "Document Build is not available on your current plan." and
      ([.model[] | select(.kind == "tool-selection" and
        .selectedTool == "loadSkill" and
        .subject == "document-build@system-document-build-v1" and
        .operationId == "verification-loadSkill")] | length) == 1 and
      ([.model[] | select(.kind == "tool-selection" and
        .selectedTool == "startDocumentBuild" and .subject == $fileId and
        .operationId == $actionId)] | length) == 1 and
      ([.model[] | select(.selectedTool == "inspectDocumentBuild")] | length) == 0 and
      (any(.telegram[];
        (.body | fromjson?) as $body |
        (($body.text? // $body.rich_message.markdown? // "") | contains($provider.agentReply))))' \
    "$feature_dir/provider.json" >/dev/null
  complete_observation "$run_id" "$feature_dir"
  printf 'observed document-build-free-denial state=%s provider=%s\n' \
    "$feature_dir/state.json" "$feature_dir/provider.json"
}

