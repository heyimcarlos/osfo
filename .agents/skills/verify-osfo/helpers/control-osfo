  container_id="$(state_value "$run_id" container-id)"
  provider_origin="$(state_value "$run_id" provider-origin)"
  phone="$(state_value "$run_id" phone-e164)"
  state_json="$(docker exec --env PGPASSWORD=osfo "$container_id" \
    psql --dbname osfo --username osfo --tuples-only --no-align --set=ON_ERROR_STOP=1 \
    --command "select json_build_object(
      'userId', u.id,
      'phoneNumber', u.phone_number,
      'phoneNumberVerified', u.phone_number_verified,
      'preferredName', u.preferred_name,
      'helpAreas', u.help_areas,
      'registrationCompletedAt', u.registration_completed_at,
      'agentId', a.agent_id,
      'billingPlan', bs.plan,
      'allowancePlan', ap.plan,
      'activeSessionCount', (select count(*) from sessions s where s.user_id = u.id and s.expires_at > now())
    ) from users u
    join agents a on a.user_id = u.id
    join billing_subscriptions bs on bs.user_id = u.id
    join lateral (
      select plan from allowance_periods where user_id = u.id order by starts_at desc limit 1
    ) ap on true
    where u.phone_number = '$phone';")"
  if [[ -z "$state_json" ]]; then
    printf 'No committed registration found for the run-owned phone number\n' >&2
    exit 1
  fi
  printf '%s\n' "$state_json" | jq . >"$feature_dir/state.json"
  curl --fail --silent --show-error "$provider_origin/_test/twilio/ledger" \
    | jq . >"$feature_dir/provider.json"
  jq --exit-status \
    --arg phone "$phone" \
    '.phoneNumber == $phone and .phoneNumberVerified == true and
      .registrationCompletedAt != null and (.agentId | startswith("agent-")) and
      .billingPlan == "free" and .allowancePlan == "free" and .activeSessionCount >= 1' \
    "$feature_dir/state.json" >/dev/null
  jq --exit-status --arg phone "$phone" \
    'length == 2 and .[0].to == $phone and .[0].code == null and
      .[1].to == $phone and .[1].code == "424242"' \
    "$feature_dir/provider.json" >/dev/null
  complete_observation "$run_id" "$feature_dir"
  printf 'observed registration state=%s provider=%s\n' \
    "$feature_dir/state.json" "$feature_dir/provider.json"
}

channel_invite() {
  local run_id state_dir provider_origin worker_origin web_origin telegram_author
  local update_id payload response_path http_status invite_url ledger_path attempt
  run_id="$1"
  doctor_run "$run_id" >/dev/null
  state_dir="$(state_dir_for "$run_id")"
  "$script_dir/claim-single-attempt" "$state_dir/channel-invite-attempted"
  provider_origin="$(state_value "$run_id" provider-origin)"
  worker_origin="$(state_value "$run_id" worker-origin)"
  web_origin="$(state_value "$run_id" web-origin)"
  telegram_author="$(state_value "$run_id" telegram-author)"
  update_id="$((telegram_author + 100000000))"
  payload="$(printf '{"update_id":%s,"message":{"message_id":1,"from":{"id":%s,"is_bot":false,"first_name":"Verification"},"chat":{"id":%s,"type":"private","first_name":"Verification"},"date":%s,"text":"I want to try Osfo"}}' \
    "$update_id" "$telegram_author" "$telegram_author" "$(date +%s)")"
  response_path="$state_dir/telegram-webhook-response.txt"
  http_status="$(curl --silent --show-error --max-time 90 \
    --output "$response_path" --write-out '%{http_code}' \
    --header 'content-type: application/json' \
    --header "x-telegram-bot-api-secret-token: $telegram_secret" \
    --data "$payload" "$worker_origin/webhooks/telegram")"
  if [[ "$http_status" != '200' ]]; then
    printf 'Telegram delivery failed with HTTP %s: %s\n' "$http_status" "$(<"$response_path")" >&2
    exit 1
  fi
  ledger_path="$state_dir/telegram-ledger.json"
  invite_url=''
  for attempt in {1..60}; do
    curl --fail --silent --show-error "$provider_origin/_test/telegram/ledger" | jq . >"$ledger_path"
    invite_url="$(jq --raw-output \
      '.[].body | fromjson? | (.text? // .rich_message.markdown? // empty)' "$ledger_path" \
      | grep -E -o "${web_origin//./\\.}/verify/[A-Za-z0-9_-]+" \
      | tail -n 1 || true)"
    if [[ -n "$invite_url" ]]; then
      break
    fi
    sleep 0.5
  done
  if [[ -z "$invite_url" ]]; then
    printf 'The local Telegram path produced no invitation. See %s and %s\n' \
      "$response_path" "$ledger_path" >&2
    exit 1
  fi
  printf '%s\n' "$invite_url" >"$state_dir/channel-invite-url"
  printf 'invite_ready url=%s author=%s\n' "$invite_url" "$telegram_author"
}

telegram_reply() {
  local run_id message state_dir provider_origin worker_origin telegram_author update_id payload
  local response_path http_status ledger_path before_count after_count reply completed
  run_id="$1"
  message="$2"
  doctor_run "$run_id" >/dev/null
  state_dir="$(state_dir_for "$run_id")"
  provider_origin="$(state_value "$run_id" provider-origin)"
  worker_origin="$(state_value "$run_id" worker-origin)"
  telegram_author="$(state_value "$run_id" telegram-author)"
  ledger_path="$state_dir/telegram-ledger.json"
  curl --fail --silent --show-error "$provider_origin/_test/telegram/ledger" | jq . >"$ledger_path"
  before_count="$(jq 'length' "$ledger_path")"
  completed=false
  update_id="$((telegram_author + 200000000 + before_count))"
  payload="$(jq --null-input --compact-output \
    --argjson updateId "$update_id" \
    --argjson author "$telegram_author" \
    --arg text "$message" \
    --argjson timestamp "$(date +%s)" \
    '{
      update_id: $updateId,
      message: {
        message_id: $updateId,
        from: { id: $author, is_bot: false, first_name: "Verification" },
        chat: { id: $author, type: "private", first_name: "Verification" },
        date: $timestamp,
        text: $text
      }
    }')"
  response_path="$state_dir/telegram-webhook-response.txt"
  http_status="$(curl --silent --show-error --max-time 90 \
    --output "$response_path" --write-out '%{http_code}' \
    --header 'content-type: application/json' \
    --header "x-telegram-bot-api-secret-token: $telegram_secret" \
    --data "$payload" "$worker_origin/webhooks/telegram")"
  if [[ "$http_status" != '200' ]]; then
    printf 'Telegram delivery failed with HTTP %s: %s\n' "$http_status" "$(<"$response_path")" >&2
    exit 1
  fi
  for _attempt in {1..60}; do
    curl --fail --silent --show-error "$provider_origin/_test/telegram/ledger" | jq . >"$ledger_path"
    after_count="$(jq 'length' "$ledger_path")"
    if jq --exit-status --argjson before "$before_count" \
      '.[ $before: ] | any(.method == "editMessageText")' "$ledger_path" >/dev/null; then
      completed=true
      break
    fi
    sleep 0.5
  done
  if [[ "$completed" != true ]]; then
    printf 'The linked Telegram Agent produced no reply\n' >&2
    exit 1
  fi
  reply="$(jq --raw-output --argjson before "$before_count" \
    '.[ $before: ] | map(select(.method == "editMessageText")) | .[-1].body | fromjson | (.text? // .rich_message.markdown? // "")' \
    "$ledger_path")"
  printf 'telegram_reply=%s\n' "$reply"
}

document_build_identities() {
  local user_id action_id
  user_id="$1"
  action_id="$2"
  require_owned_identifier 'User ID' "$user_id"
  require_owned_identifier 'Document Build action ID' "$action_id"
  (
    cd "$repo_root"
    OSFO_DOCUMENT_BUILD_USER_ID="$user_id" OSFO_DOCUMENT_BUILD_ACTION_ID="$action_id" \
      bun -e '
        import { Effect } from "effect";
        import { UserId } from "./apps/worker/src/domain";
        import { ActionId } from "./apps/worker/src/domain/action-execution";
        import { DocumentBuild } from "./apps/worker/src/services/document-build";

        const userId = process.env.OSFO_DOCUMENT_BUILD_USER_ID;
        const actionId = process.env.OSFO_DOCUMENT_BUILD_ACTION_ID;
        if (userId === undefined || actionId === undefined) {
          throw new Error("Document Build verification identity is missing");
        }
        const workflowId = await Effect.runPromise(DocumentBuild.workflowIdFor(
          UserId.make(userId),
          ActionId.make(actionId),
        ));
        const instances = await Effect.runPromise(DocumentBuild.cloudflareInstanceIdsFor(workflowId));
        process.stdout.write(JSON.stringify({ workflowId, ...instances }));
      '
  )
}

document_build_free_denial() {
  local run_id file_id state_dir feature_dir container_id provider_origin inbox_url phone identity
  local user_id agent_id billing_plan billing_policy allowance_plan allowance_policy
  local action_id success_action_id identities workflow_id main_instance_id timer_instance_id
  local request before_model_count reply_output reply
  run_id="$1"
  file_id="$2"
  doctor_run "$run_id" >/dev/null
  state_dir="$(state_dir_for "$run_id")"
  feature_dir="$(feature_artifact_dir_for "$run_id" document-build-free-denial)"
  if [[ ! -s "$feature_dir/metadata.txt" ]]; then
    printf 'Start document-build-free-denial evidence before the checkpoint\n' >&2
    exit 1
  fi
  if [[ ! "$file_id" =~ ^web:[0-9a-f-]{36}$ ]]; then
    printf 'Invalid browser-owned Document Build File ID: %s\n' "$file_id" >&2
    exit 2
  fi
  "$script_dir/claim-single-attempt" "$state_dir/document-build-free-denial-attempted"
  container_id="$(state_value "$run_id" container-id)"
  provider_origin="$(state_value "$run_id" provider-origin)"
  inbox_url="$provider_origin/inbox"
  phone="$(state_value "$run_id" phone-e164)"
  identity="$(docker exec --env PGPASSWORD=osfo "$container_id" \
    psql --dbname osfo --username osfo --tuples-only --no-align --set=ON_ERROR_STOP=1 \
    --command "select json_build_object(
      'userId', u.id,
      'agentId', a.agent_id,
      'billingPlan', bs.plan,
      'billingPolicy', bs.plan_policy_version,
      'allowancePlan', ap.plan,
      'allowancePolicy', ap.plan_policy_version
    ) from users u
    join agents a on a.user_id = u.id
    join billing_subscriptions bs on bs.user_id = u.id
    join lateral (
      select plan, plan_policy_version from allowance_periods
      where user_id = u.id order by starts_at desc limit 1
    ) ap on true
    where u.phone_number = '$phone';")"
  if [[ -z "$identity" ]]; then
    printf 'No registered User and Agent exist for the run-owned phone\n' >&2
    exit 1
  fi
  user_id="$(jq --exit-status --raw-output '.userId' <<<"$identity")"
  agent_id="$(jq --exit-status --raw-output '.agentId' <<<"$identity")"
  billing_plan="$(jq --exit-status --raw-output '.billingPlan' <<<"$identity")"
  billing_policy="$(jq --exit-status --raw-output '.billingPolicy' <<<"$identity")"
  allowance_plan="$(jq --exit-status --raw-output '.allowancePlan' <<<"$identity")"
  allowance_policy="$(jq --exit-status --raw-output '.allowancePolicy' <<<"$identity")"
  require_owned_identifier 'User ID' "$user_id"
  require_owned_identifier 'Agent ID' "$agent_id"
  if [[ "$billing_plan" != free || "$allowance_plan" != free || \
    "$billing_policy" != launch-v1 || "$allowance_policy" != launch-v1 ]]; then
    printf 'Free denial checkpoint requires current launch-v1 Free billing and allowance facts\n' >&2
    exit 1
  fi
  action_id="verification-startDocumentBuild-free-$run_id"
  success_action_id='verification-startDocumentBuild'
  if [[ "$action_id" == "$success_action_id" ]]; then
    printf 'Free denial and Adventurer success actions must differ\n' >&2
    exit 1
  fi
  identities="$(document_build_identities "$user_id" "$action_id")"
  workflow_id="$(jq --exit-status --raw-output '.workflowId' <<<"$identities")"
  main_instance_id="$(jq --exit-status --raw-output '.main' <<<"$identities")"
  timer_instance_id="$(jq --exit-status --raw-output '.timer' <<<"$identities")"
  before_model_count="$(curl --fail --silent --show-error \
    "$provider_origin/_test/research/ledger" | jq 'length')"
  curl --fail --silent --show-error --request POST --get \
    --data-urlencode "actionId=$action_id" \
    "$provider_origin/_test/research/next-document-build-action" >/dev/null
  request="Build a PDF from uploaded File ID $file_id."
  reply_output="$(telegram_reply "$run_id" "$request")"
  if [[ "$reply_output" != telegram_reply=* ]]; then
    printf 'The Free Document Build attempt returned no captured Telegram reply\n' >&2
    exit 1
  fi
  reply="${reply_output#telegram_reply=}"
  printf '%s\n' "$request" >"$feature_dir/agent-request.txt"
  printf '%s\n' "$reply" >"$feature_dir/agent-reply.txt"
  curl --fail --silent --show-error "$provider_origin/_test/research/ledger" \
    | jq --argjson before "$before_model_count" '.[ $before: ]' \
      >"$feature_dir/model-selection.json"
  "$script_dir/assert-document-build-free-denial" \
    "$feature_dir/agent-reply.txt" "$feature_dir/model-selection.json" "$action_id" "$file_id"
  printf '%s\n' "$file_id" >"$state_dir/document-build-free-file-id"
  printf '%s\n' "$user_id" >"$state_dir/document-build-free-user-id"
  printf '%s\n' "$agent_id" >"$state_dir/document-build-free-agent-id"
  printf '%s\n' "$action_id" >"$state_dir/document-build-free-action-id"
  printf '%s\n' "$success_action_id" >"$state_dir/document-build-success-action-id"
  printf '%s\n' "$workflow_id" >"$state_dir/document-build-free-workflow-id"
  printf '%s\n' "$main_instance_id" >"$state_dir/document-build-free-main-instance-id"
  printf '%s\n' "$timer_instance_id" >"$state_dir/document-build-free-timer-instance-id"
  printf '%s\n' "$before_model_count" >"$state_dir/document-build-free-model-ledger-before-count"
  printf '%s\n' "$inbox_url" >"$state_dir/document-build-free-inbox-url"
  printf 'document_build_free_denial_ready action=%s workflow=%s inbox=%s reply=%s\n' \
    "$action_id" "$workflow_id" "$inbox_url" "$feature_dir/agent-reply.txt"
}

