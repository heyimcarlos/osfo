      'providerCostBasis', (select a.basis from allowance_usage a where a.user_id = u.id and a.source_type = 'documentProviderOperation' and a.source_id = db.cost_evidence_json::jsonb ->> 'providerOperationId' and a.allowance_kind = 'vendorUsdMicros' limit 1),
      'sharedUsageEvents', (select count(*) from usage_events e where e.user_id = u.id and e.root_operation_id = db.workflow_id)
    ) from users u
    join lateral (
      select * from document_builds where user_id = u.id order by admitted_at desc limit 1
    ) db on true
    where u.phone_number = '$phone';")"
  if [[ -z "$state_json" ]]; then
    printf 'No committed Document Build found for the run-owned User\n' >&2
    exit 1
  fi
  user_id="$(jq --exit-status --raw-output '.userId' <<<"$state_json")"
  agent_id="$(jq --exit-status --raw-output '.agentId' <<<"$state_json")"
  action_id="$(jq --exit-status --raw-output '.actionId' <<<"$state_json")"
  free_action_id="$(state_value "$run_id" document-build-free-action-id)"
  provider_operation_id='verification-startDocumentBuild'
  file_id="$(jq --exit-status --raw-output '.sourceFileId' <<<"$state_json")"
  artifact_id="$(jq --exit-status --raw-output '.artifactContentId' <<<"$state_json")"
  main_instance_id="$(jq --exit-status --raw-output '.cloudflareInstanceId' <<<"$state_json")"
  timer_instance_id="$(jq --exit-status --raw-output '.cloudflareTimerInstanceId' <<<"$state_json")"
  runtime="$(inspect_agent_runtime "$run_id" "$agent_id" "$user_id" "$file_id" \
    "$main_instance_id" "$timer_instance_id" "$artifact_id")"
  files_bucket="$(jq --exit-status --raw-output \
    '.r2_buckets[] | select(.binding == "FILES") | .bucket_name' "$state_dir/wrangler.json")"
  artifacts_bucket="$(jq --exit-status --raw-output \
    '.r2_buckets[] | select(.binding == "ARTIFACTS") | .bucket_name' "$state_dir/wrangler.json")"
  source_key="users/$(VERIFICATION_PART="$user_id" bun -e 'process.stdout.write(encodeURIComponent(process.env.VERIFICATION_PART))')/files/$(VERIFICATION_PART="$file_id" bun -e 'process.stdout.write(encodeURIComponent(process.env.VERIFICATION_PART))')/source"
  artifact_key="client-content/$(VERIFICATION_CONTENT_ID="$artifact_id" bun -e '
    process.stdout.write(Array.from(new TextEncoder().encode(process.env.VERIFICATION_CONTENT_ID), (byte) => byte.toString(16).padStart(2, "0")).join(""));
  ')"
  attempt_key="${artifact_key/client-content\//document-attempts/}"
  owner_key="document-owners/by-user/$(VERIFICATION_PART="$user_id" bun -e 'process.stdout.write(encodeURIComponent(process.env.VERIFICATION_PART))')/${artifact_key#client-content/}"
  if r2_object_exists "$state_dir" "$files_bucket" "$source_key"; then source_exists=true; else source_exists=false; fi
  if artifact_object_sha256="$(r2_object_sha256 \
    "$state_dir" "$artifacts_bucket" "$artifact_key")"; then
    artifact_exists=true
  else
    artifact_exists=false
    artifact_object_sha256=''
  fi
  if r2_object_exists "$state_dir" "$artifacts_bucket" "$attempt_key"; then attempt_exists=true; else attempt_exists=false; fi
  if r2_object_exists "$state_dir" "$artifacts_bucket" "$owner_key"; then owner_exists=true; else owner_exists=false; fi
  jq --null-input \
    --argjson postgres "$state_json" \
    --argjson runtime "$runtime" \
    --argjson sourceExists "$source_exists" \
    --argjson artifactExists "$artifact_exists" \
    --arg artifactObjectSha256 "$artifact_object_sha256" \
    --argjson attemptExists "$attempt_exists" \
    --argjson ownerExists "$owner_exists" \
    '$postgres + { agentRuntime: $runtime, sourceExists: $sourceExists,
      artifactExists: $artifactExists, artifactObjectSha256: $artifactObjectSha256,
      attemptExists: $attemptExists,
      ownerExists: $ownerExists }' >"$feature_dir/state.json"
  jq --null-input \
    --argjson costEvidence "$(jq '.costEvidence' <<<"$state_json")" \
    --argjson providerCostQuantity "$(jq '.providerCostQuantity' <<<"$state_json")" \
    --argjson providerCostBasis "$(jq '.providerCostBasis' <<<"$state_json")" \
    --argjson model "$(curl --fail --silent --show-error "$provider_origin/_test/research/ledger")" \
    --argjson telegram "$(curl --fail --silent --show-error "$provider_origin/_test/telegram/ledger")" \
    '{ costEvidence: $costEvidence, providerCostQuantity: $providerCostQuantity,
      providerCostBasis: $providerCostBasis, model: $model, telegram: $telegram }' \
    >"$feature_dir/provider.json"
  jq --exit-status \
    --arg freeActionId "$free_action_id" \
    '.state == "success" and .format == "pdf" and .safeFailureCode == null and
      .actionId != $freeActionId and
      .artifactContentId == ("document:workflow:" + .workflowId) and
      (.inputDigest | test("^[0-9a-f]{64}$")) and .sourceCount == 1 and
      .sourceMediaType == "text/plain" and
      .acceptedAt != null and .startedAt != null and .providerCostRecordedAt != null and
      .previewStoredAt != null and .providerCostRecordedAt <= .previewStoredAt and
      .accountingCommittedAt != null and .publicationCommittedAt != null and
      .artifactAccountedAt != null and .terminalAt != null and
      .elapsedSeconds >= 0 and .elapsedSeconds <= 3600 and
      .cloudflareInstanceId != .cloudflareTimerInstanceId and
      .previewNotifications <= 1 and .terminalNotifications == 1 and
      .terminalNotificationAfterTruth == true and
      .workflowStartUsage == 1 and .generatedDocumentUsage == 1 and
      .providerCostUsage == 1 and .sharedUsageEvents == 0 and
      .sourceExists == true and .artifactExists == true and
      .attemptExists == true and .ownerExists == true and
      .agentRuntime.inspectable == true and .agentRuntime.registered == true and
      .agentRuntime.documentBuildSource._tag == "Found" and
      .agentRuntime.documentBuildSource.fileId == .sourceFileId and
      .agentRuntime.documentBuildSource.userId == .userId and
      .agentRuntime.documentBuildSource.mediaType == .sourceMediaType and
      .agentRuntime.documentBuildSource.byteLength == .sourceByteLength and
      .agentRuntime.documentBuildSource.sha256 == .sourceSha256 and
      .agentRuntime.documentBuildMain != null and .agentRuntime.documentBuildTimer != null' \
    "$feature_dir/state.json" >/dev/null
  "$script_dir/assert-document-build-artifact-state" "$feature_dir/state.json"
  "$script_dir/assert-document-build-provider-state" \
    "$feature_dir/provider.json" "$file_id" \
    "$(jq --raw-output '.workflowId' <<<"$state_json")" "$artifact_id" \
    "$action_id" "$provider_operation_id"
  printf '%s\n' "$file_id" >"$state_dir/document-build-file-id"
  printf '%s\n' "$artifact_id" >"$state_dir/document-build-artifact-id"
  printf '%s\n' "$main_instance_id" >"$state_dir/document-build-main-instance-id"
  printf '%s\n' "$timer_instance_id" >"$state_dir/document-build-timer-instance-id"
  complete_observation "$run_id" "$feature_dir"
  printf 'observed document-build state=%s provider=%s\n' \
    "$feature_dir/state.json" "$feature_dir/provider.json"
}

observe_scheduled_email() {
  local run_id state_dir feature_dir container_id provider_origin phone state_json
