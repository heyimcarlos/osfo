  user_id="$(jq --exit-status --raw-output '.userId' <<<"$state_json")"
  agent_id="$(jq --exit-status --raw-output '.agentId' <<<"$state_json")"
  instance_id="$(jq --exit-status --raw-output '.cloudflareInstanceId' <<<"$state_json")"
  agent_runtime="$(inspect_agent_runtime \
    "$run_id" "$agent_id" "$user_id" '' '' '' '' "$instance_id")"
  jq --null-input \
    --argjson postgres "$state_json" \
    --argjson agentRuntime "$agent_runtime" \
    '$postgres + { agentRuntime: $agentRuntime }' \
    >"$feature_dir/state.json"
  jq --null-input \
    --argjson integration "$(curl --fail --silent --show-error "$provider_origin/_test/integrations/ledger")" \
    --argjson model "$(curl --fail --silent --show-error "$provider_origin/_test/research/ledger")" \
    --argjson telegram "$(curl --fail --silent --show-error "$provider_origin/_test/telegram/ledger")" \
    '{ integration: $integration, model: $model, telegram: $telegram }' \
    >"$feature_dir/provider.json"
  jq --exit-status \
    --arg recipient "$recipient" --arg subject "$subject" --arg body "$body" --arg dueAt "$due_at" \
    '.workflowCount == 1 and .state == "success" and .sendOutcome == "applied" and
      .sendAccountingBasis == "observed" and .safeFailureCode == null and
      (.providerLogId | length) > 0 and (.providerResourceId | length) > 0 and
      .request.gmailResource == "primary" and .request.recipients == [$recipient] and
      .request.subject == $subject and .request.body == $body and .request.scheduledAt == $dueAt and
      .approvalPresentation.operation == "integration.effect" and
      .approvalPresentation.actionDefinitionVersion == "osfo-scheduled-email-start-v1" and
      .admittedAt != null and .acceptedAt != null and .waitingAt != null and
      .dueAt != null and .sendStartedAt != null and .sendOutcomeAt != null and .terminalAt != null and
      .admittedAt <= .acceptedAt and .acceptedAt <= .waitingAt and .waitingAt <= .dueAt and
      .dueAt <= .sendStartedAt and .sendStartedAt <= .sendOutcomeAt and .sendOutcomeAt <= .terminalAt and
      .dueToSendMilliseconds >= 0 and .dueToSendMilliseconds <= 60000 and
      .sendToTerminalMilliseconds >= 0 and .sendToTerminalMilliseconds <= 120000 and
      .terminalToFollowUpMilliseconds >= 0 and .terminalToFollowUpMilliseconds <= 60000 and
      .notificationCount == 1 and .acceptedNotifications == 1 and
      .workflowStartUsage == 1 and .gmailSendUsage == 1 and .gmailSendBasis == "observed" and
      .agentRuntime.inspectable == true and .agentRuntime.registered == true and
      .agentRuntime.scheduledEmailWorkflow.status == "complete"' \
    "$feature_dir/state.json" >/dev/null
  jq --exit-status \
    --arg recipient "$recipient" --arg subject "$subject" --arg body "$body" --arg dueAt "$due_at" \
    --from-file "$repo_root/.agents/skills/verify-osfo/helpers/scheduled-email-approval.jq" \
    "$feature_dir/state.json" >/dev/null
  jq --exit-status \
    --arg recipient "$recipient" --arg subject "$subject" --arg body "$body" --arg dueAt "$due_at" \
    --arg providerLogId "$(jq --raw-output '.providerLogId' <<<"$state_json")" \
    --arg providerResourceId "$(jq --raw-output '.providerResourceId' <<<"$state_json")" \
    '([.integration[] | select(
        .providerTool == "GMAIL_SEND_EMAIL" and .input.recipient_email == $recipient and
        .input.subject == $subject and .input.body == $body and
        .logId == $providerLogId and .resourceId == $providerResourceId)] | length) == 1 and
      (.integration | length) == 1 and
      ([.model[] | select(.kind == "tool-selection" and .selectedTool == "scheduleEmail" and
        .subject == ($recipient + "|" + $subject + "|" + $body + "|" + $dueAt))] | length) == 1' \
    "$feature_dir/provider.json" >/dev/null
  printf '%s\n' "$(jq --raw-output '.workflowId' <<<"$state_json")" \
    >"$state_dir/scheduled-email-workflow-id"
  complete_observation "$run_id" "$feature_dir"
  printf 'observed scheduled-email state=%s provider=%s\n' \
    "$feature_dir/state.json" "$feature_dir/provider.json"
}

