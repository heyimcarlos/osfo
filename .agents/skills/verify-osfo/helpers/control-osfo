  curl --fail --silent --show-error "$provider_origin/_test/telegram/ledger" \
    | jq . >"$feature_dir/provider.json"
  jq --exit-status \
    --arg phone "$phone" --arg author "$telegram_author" \
    '.phoneNumber == $phone and .channelId == "telegram" and .authorId == $author and
      .revokedAt == null and .inviteState == "accepted" and .acceptedAt != null and
      .acceptedUserId == .userId and .acceptedChannelLinkId == .channelLinkId and
      .acceptedRunInviteCount == 1 and .activeRunLinkCount == 1 and
      .acceptedAuditCount == 1' "$feature_dir/state.json" >/dev/null
  jq --exit-status --arg author "$telegram_author" --arg invite "$invite_url" \
    '([.[] |
      (.body | fromjson?) as $body |
      select(($body != null) and (($body.chat_id | tostring) == $author) and
        (($body.text? // $body.rich_message.markdown? // "") | contains($invite)))] |
      length) == 1' \
    "$feature_dir/provider.json" >/dev/null
  complete_observation "$run_id" "$feature_dir"
  printf 'observed channel-linking state=%s provider=%s\n' \
    "$feature_dir/state.json" "$feature_dir/provider.json"
}

assert_conversation_memory_evidence() {
  local run_id state_file provider_file superseded corrected
  run_id="$1"
  state_file="$2"
  provider_file="$3"
  superseded="spruce-soda-$run_id"
  corrected="cedar-cocoa-$run_id"
  jq --exit-status --arg runId "$run_id" --arg superseded "$superseded" --arg corrected "$corrected" \
    'def isSetContextTrace:
      .state? == "output-available" and
      ((.toolName? == "set_context") or (.type? == "tool-set_context"));
    def isPersistedToolCallId($operationId):
      type == "string" and
      ((split("::cf-wai-tool-call::")) as $parts |
        ($parts | length) == 2 and
        $parts[0] == $operationId and
        ($parts[1] | length) > 0);
    .conversation.historicalSessions[0] as $history |
    ([$history.messages[]?.parts[]? | select(isSetContextTrace)]) as $sessionWrites |
    ([$history.messages[3].parts[]? | select(isSetContextTrace)]) as $initialSessionWrites |
    ([$history.messages[5].parts[]? | select(isSetContextTrace)]) as $correctionSessionWrites |
    .registered == true and
      .inspectable == true and
      .identity.activeTelegramLinkCount == 1 and
      .conversation._tag == "ConversationEvidence" and
      .conversation.agent.currentSessionId == .conversation.route.currentSessionId and
      (.conversation.route.historicalSessionIds | length) == 1 and
      (.conversation.historicalSessions | length) == 1 and
      .conversation.route.currentSessionId != .conversation.route.historicalSessionIds[0] and
      .conversation.currentSession._tag == "SessionHistoryFound" and
      .conversation.currentSession.sessionId == .conversation.route.currentSessionId and
      $history._tag == "SessionHistoryFound" and
      $history.sessionId == .conversation.route.historicalSessionIds[0] and
      ($history.messages | length) == 6 and
      ($history.messages | map(.role)) == [
        "user", "assistant", "user", "assistant", "user", "assistant"
      ] and
      ($history.messages | map(.id) | unique | length) == 6 and
      all($history.messages[]; (.id | length) > 0) and
      ($history.messages[0].parts | length) == 1 and
      $history.messages[0].parts[0] == {
        type: "text", text: ("Give me a normal run-owned reply for " + $runId + ".")
      } and
      ([$history.messages[1].parts[] | select(.type? == "text") | .text]) == [
        ("Committed Osfo result: Give me a normal run-owned reply for " + $runId + ".")
      ] and
      ($history.messages[2].parts | length) == 1 and
      $history.messages[2].parts[0] == {
        type: "text", text: ("Remember that my run-owned verification drink is " + $superseded + ".")
      } and
      ([$history.messages[3].parts[] | select(.type? == "text") | .text]) == [
        "I remembered your run-owned verification drink."
      ] and
      ($initialSessionWrites | length) == 1 and
      ($initialSessionWrites[0].toolCallId |
        isPersistedToolCallId("verification-set_context-initial")) and
      ($history.messages[4].parts | length) == 1 and
      $history.messages[4].parts[0] == {
        type: "text",
        text: ("Correction: remember that my run-owned verification drink is " + $corrected + ", not " + $superseded + ".")
      } and
      ([$history.messages[5].parts[] | select(.type? == "text") | .text]) == [
        "I corrected your run-owned verification drink."
      ] and
      ($correctionSessionWrites | length) == 1 and
      ($correctionSessionWrites[0].toolCallId |
        isPersistedToolCallId("verification-set_context-correction")) and
      $initialSessionWrites[0].toolCallId != $correctionSessionWrites[0].toolCallId and
      ($sessionWrites | length) == 2 and
      (.conversation.currentSession.messages | length) == 2 and
      (.conversation.currentSession.messages[0].id | length) > 0 and
      (.conversation.currentSession.messages[1].id | length) > 0 and
      .conversation.currentSession.messages[0].id != .conversation.currentSession.messages[1].id and
      .conversation.currentSession.messages[0].role == "user" and
      (.conversation.currentSession.messages[0].parts | length) == 1 and
      .conversation.currentSession.messages[0].parts[0] == {
        type: "text", text: "What is my run-owned verification drink?"
      } and
      .conversation.currentSession.messages[1].role == "assistant" and
      .conversation.currentSession.messages[1].parts == [
        { type: "step-start" },
        {
          type: "text",
          text: ("Your run-owned verification drink is " + $corrected + "."),
          state: "done"
        }
      ] and
      (.conversation.currentSession | tostring | contains($superseded) | not) and
      (.conversation.currentSession | tostring | contains("normal run-owned reply") | not) and
      (.conversation.currentSession | tostring | contains("Correction: remember that") | not) and
      (.conversation.currentSession | tostring | contains("set_context") | not) and
      (.conversation.currentSession | tostring | contains("sessionRecall") | not)' \
    "$state_file" >/dev/null
  jq --exit-status --arg runId "$run_id" --arg superseded "$superseded" --arg corrected "$corrected" \
    '([.model[] | select(.kind == "tool-selection")]) as $selections |
      ([.model[] | select(.kind == "tool-selection" and .selectedTool == "set_context")]) as $writes |
      ([.model[] | select(.kind == "agent" and .recallRequest? != null)]) as $recalls |
      ([.supermemory.ledger[] | select(.path == "/v4/profile")]) as $profiles |
      ([.supermemory.ledger[] | select(.path == "/v4/search")]) as $searches |
      $recalls[0] as $recall |
      ([.supermemory.ledger[] |
        select(.sequence == ($recall.sequence - 2) or .sequence == ($recall.sequence - 1))
      ]) as $recallMemory |
      ($selections | length) == 2 and
      all($selections[]; .selectedTool == "set_context") and
      ($writes | length) == 2 and
      $writes[0].operationId == "verification-set_context-initial" and
      $writes[0].arguments == {
        action: "append", block: "userContext",
        content: ("My run-owned verification drink is " + $superseded + ".")
      } and
      $writes[1].operationId == "verification-set_context-correction" and
      $writes[1].arguments == {
        action: "replace", block: "userContext",
        content: ("My run-owned verification drink is " + $corrected + ".")
      } and
      ($writes[1].arguments.content | contains($superseded) | not) and
      ([.model[] | select(.kind == "tool-selection" and .selectedTool == "sessionRecall")] | length) == 0 and
      ($recalls | length) == 1 and
      ($recall.sequence | type) == "number" and
      $recall.latestAgentSequence == $recall.sequence and
      $recall.recallRequest.nonSystemMessages == [
        { content: "What is my run-owned verification drink?", role: "user" }
      ] and
      $recall.recallRequest.requestMessageCount ==
        ($recall.recallRequest.systemMessageCount + 1) and
      $recall.recallRequest.systemMessageCount >= 1 and
      $recall.recallRequest.userContextSections == [
        ("My run-owned verification drink is " + $corrected + ".")
      ] and
      $recall.recallRequest.correctedOutsideUserContextCount == 0 and
      $recall.recallRequest.supersededCount == 0 and
      $recall.recallRequest.copiedHistoricalTurnCount == 0 and
      ($recallMemory | length) == 2 and
      ([$recallMemory[].path] | sort) == ["/v4/profile", "/v4/search"] and
      ([$recallMemory[].sequence] | sort) == [($recall.sequence - 2), ($recall.sequence - 1)] and
      ([ $recallMemory[] | select(
        .path == "/v4/profile" and .method == "POST" and
        .dynamicProfileCount == 0 and .staticProfileCount == 0 and .searchResultCount == 0
      ) ] | length) == 1 and
      ([ $recallMemory[] | select(
        .path == "/v4/search" and .method == "POST" and .searchResultCount == 0
      ) ] | length) == 1 and
      any(.telegram[];
        (.body | fromjson? | (.text? // .rich_message.markdown? // "")) ==
          ("Committed Osfo result: Give me a normal run-owned reply for " + $runId + ".")) and
      any(.telegram[];
        (.body | fromjson? | (.text? // .rich_message.markdown? // "")) == "Started a new Osfo session.") and
      any(.telegram[];
        (.body | fromjson? | (.text? // .rich_message.markdown? // "")) ==
          ("Your run-owned verification drink is " + $corrected + ".")) and
      (all(.telegram[];
        (.body | fromjson? | (.text? // .rich_message.markdown? // "")) |
          (contains("Your run-owned verification drink is " + $superseded + ".") | not))) and
      (.supermemory.containers | length) == 0 and
      ($profiles | length) >= 1 and
      all($profiles[];
        .method == "POST" and .dynamicProfileCount == 0 and
        .staticProfileCount == 0 and .searchResultCount == 0) and
      ($searches | length) >= 1 and
      all($searches[]; .method == "POST" and .searchResultCount == 0) and
      (.supermemory.ledger | length) == (($profiles | length) + ($searches | length))' \
    "$provider_file" >/dev/null
}

observe_conversation_memory() {
  local run_id state_dir feature_dir container_id provider_origin phone identity user_id agent_id
  local runtime model_before telegram_before supermemory_before
  run_id="$1"
  state_dir="$(state_dir_for "$run_id")"
  feature_dir="$(feature_artifact_dir_for "$run_id" conversation-memory)"
  begin_observation "$feature_dir"
  container_id="$(state_value "$run_id" container-id)"
  provider_origin="$(state_value "$run_id" provider-origin)"
  phone="$(state_value "$run_id" phone-e164)"
  identity="$(docker exec --env PGPASSWORD=osfo "$container_id" \
    psql --dbname osfo --username osfo --tuples-only --no-align --set=ON_ERROR_STOP=1 \
    --command "select json_build_object(
      'userId', u.id,
      'agentId', a.agent_id,
      'activeTelegramLinkCount', count(cl.channel_link_id)
    ) from users u
    join agents a on a.user_id = u.id
    join channel_links cl on cl.user_id = u.id
    where u.phone_number = '$phone' and cl.channel_id = 'telegram' and cl.revoked_at is null
    group by u.id, a.agent_id;")"
  if [[ -z "$identity" ]]; then
    printf 'Complete registration and Telegram channel linking before conversation memory\n' >&2
    exit 1
  fi
  user_id="$(jq --exit-status --raw-output '.userId' <<<"$identity")"
  agent_id="$(jq --exit-status --raw-output '.agentId' <<<"$identity")"
  require_owned_identifier 'User ID' "$user_id"
  require_owned_identifier 'Agent ID' "$agent_id"
  runtime="$(inspect_agent_runtime "$run_id" "$agent_id" "$user_id" '' '' '' '' '' 1)"
  jq --argjson identity "$identity" '. + { identity: $identity }' <<<"$runtime" \
    >"$feature_dir/state.json"

  model_before="$(state_value "$run_id" conversation-memory-model-ledger-before-count)"
  telegram_before="$(state_value "$run_id" conversation-memory-telegram-ledger-before-count)"
  supermemory_before="$(state_value "$run_id" conversation-memory-supermemory-ledger-before-count)"
  jq --null-input \
    --argjson model "$(curl --fail --silent --show-error \
      "$provider_origin/_test/research/ledger" | jq --argjson before "$model_before" '.[ $before: ]')" \
    --argjson telegram "$(curl --fail --silent --show-error \
      "$provider_origin/_test/telegram/ledger" | jq --argjson before "$telegram_before" '.[ $before: ]')" \
    --argjson supermemoryLedger "$(curl --fail --silent --show-error \
      "$provider_origin/_test/supermemory/ledger" | jq --argjson before "$supermemory_before" '.[ $before: ]')" \
    --argjson supermemoryContainers "$(curl --fail --silent --show-error \
      "$provider_origin/_test/supermemory/containers")" \
    '{ model: $model, telegram: $telegram,
      supermemory: { containers: $supermemoryContainers, ledger: $supermemoryLedger } }' \
    >"$feature_dir/provider.json"

  assert_conversation_memory_evidence \
    "$run_id" "$feature_dir/state.json" "$feature_dir/provider.json"
  complete_observation "$run_id" "$feature_dir"
  printf 'observed conversation-memory state=%s provider=%s\n' \
    "$feature_dir/state.json" "$feature_dir/provider.json"
}

observe_research_report() {
  local run_id state_dir feature_dir container_id provider_origin phone state_json
  local files_bucket artifacts_bucket manifest_key source_key synthesis_key artifact_id artifact_key
  local manifest_exists source_exists synthesis_exists artifact_exists
  run_id="$1"
  state_dir="$(state_dir_for "$run_id")"
  feature_dir="$(feature_artifact_dir_for "$run_id" research-report)"
  begin_observation "$feature_dir"
  container_id="$(state_value "$run_id" container-id)"
  provider_origin="$(state_value "$run_id" provider-origin)"
  phone="$(state_value "$run_id" phone-e164)"
  state_json="$(docker exec --env PGPASSWORD=osfo "$container_id" \
    psql --dbname osfo --username osfo --tuples-only --no-align --set=ON_ERROR_STOP=1 \
    --command "select json_build_object(
      'userId', u.id,
      'workflowId', rr.workflow_id,
      'state', rr.state,
      'safeFailureCode', rr.safe_failure_code,
      'sourceManifestKey', rr.source_manifest_key,
      'sourceManifestDigest', rr.source_manifest_digest,
      'sourceEvidenceKey', (select o.result_json::jsonb ->> 'contentKey' from research_report_provider_operations o where o.workflow_id = rr.workflow_id and o.kind = 'page' and o.state = 'completed' limit 1),
      'artifactContentId', rr.artifact_content_id,
      'admittedAt', rr.admitted_at,
      'acceptedAt', rr.accepted_at,
      'startedAt', rr.started_at,
      'sourcesCommittedAt', rr.sources_committed_at,
      'artifactStoredAt', rr.artifact_stored_at,
      'terminalAt', rr.terminal_at,
      'elapsedSeconds', extract(epoch from (rr.terminal_at - rr.admitted_at)),
      'searchOperations', (select count(*) from research_report_provider_operations o where o.workflow_id = rr.workflow_id and o.kind = 'search'),
      'pageOperations', (select count(*) from research_report_provider_operations o where o.workflow_id = rr.workflow_id and o.kind = 'page'),
      'completedProviderOperations', (select count(*) from research_report_provider_operations o where o.workflow_id = rr.workflow_id and o.state = 'completed'),
      'providerOperationsWithBodies', (select count(*) from research_report_provider_operations o where o.workflow_id = rr.workflow_id and o.result_json::jsonb ? 'content'),
      'synthesisOperations', (select count(*) from research_report_synthesis_operations o where o.workflow_id = rr.workflow_id and o.state = 'completed'),
      'synthesisKey', (select result_key from research_report_synthesis_operations o where o.workflow_id = rr.workflow_id limit 1),
      'terminalNotifications', (select count(*) from research_report_notifications n where n.workflow_id = rr.workflow_id and n.kind = 'terminal' and n.think_submission_id is not null and n.delivered_at is not null),
      'workflowStartUsage', (select count(*) from allowance_usage a where a.user_id = u.id and a.source_id = rr.workflow_id and a.allowance_kind = 'workflowStarts'),
      'researchReportUsage', (select count(*) from allowance_usage a where a.user_id = u.id and a.source_id = rr.workflow_id and a.allowance_kind = 'researchReports')
    ) from users u
    join lateral (
      select * from research_reports where user_id = u.id order by admitted_at desc limit 1
    ) rr on true
    where u.phone_number = '$phone';")"
  if [[ -z "$state_json" ]]; then
    printf 'No committed Research Report found for the run-owned User\n' >&2
    exit 1
  fi
  manifest_key="$(jq --exit-status --raw-output '.sourceManifestKey' <<<"$state_json")"
  source_key="$(jq --exit-status --raw-output '.sourceEvidenceKey' <<<"$state_json")"
  synthesis_key="$(jq --exit-status --raw-output '.synthesisKey' <<<"$state_json")"
  artifact_id="$(jq --exit-status --raw-output '.artifactContentId' <<<"$state_json")"
  files_bucket="$(jq --exit-status --raw-output \
    '.r2_buckets[] | select(.binding == "FILES") | .bucket_name' "$state_dir/wrangler.json")"
  artifacts_bucket="$(jq --exit-status --raw-output \
    '.r2_buckets[] | select(.binding == "ARTIFACTS") | .bucket_name' "$state_dir/wrangler.json")"
  artifact_key="client-content/$(VERIFICATION_CONTENT_ID="$artifact_id" bun -e '
    process.stdout.write(Array.from(new TextEncoder().encode(process.env.VERIFICATION_CONTENT_ID), (byte) => byte.toString(16).padStart(2, "0")).join(""));
  ')"
  if r2_object_exists "$state_dir" "$files_bucket" "$manifest_key"; then manifest_exists=true; else manifest_exists=false; fi
  if r2_object_exists "$state_dir" "$files_bucket" "$source_key"; then source_exists=true; else source_exists=false; fi
  if r2_object_exists "$state_dir" "$files_bucket" "$synthesis_key"; then synthesis_exists=true; else synthesis_exists=false; fi
  if r2_object_exists "$state_dir" "$artifacts_bucket" "$artifact_key"; then artifact_exists=true; else artifact_exists=false; fi
  jq --null-input \
    --argjson postgres "$state_json" \
    --argjson sourceManifestExists "$manifest_exists" \
    --argjson sourceEvidenceExists "$source_exists" \
    --argjson synthesisExists "$synthesis_exists" \
    --argjson artifactExists "$artifact_exists" \
    '$postgres + { sourceManifestExists: $sourceManifestExists, sourceEvidenceExists: $sourceEvidenceExists, synthesisExists: $synthesisExists, artifactExists: $artifactExists }' \
    >"$feature_dir/state.json"
  curl --fail --silent --show-error "$provider_origin/_test/research/ledger" \
    | jq . >"$feature_dir/provider.json"
  jq --exit-status \
    '.state == "success" and .safeFailureCode == null and
      .acceptedAt != null and .startedAt != null and .sourcesCommittedAt != null and
      .artifactStoredAt != null and .terminalAt != null and
      .elapsedSeconds >= 0 and .elapsedSeconds <= 3600 and
      .searchOperations == 1 and .pageOperations == 1 and
      .completedProviderOperations == 2 and .providerOperationsWithBodies == 0 and
      .synthesisOperations == 1 and .terminalNotifications == 1 and
      .workflowStartUsage == 1 and .researchReportUsage == 1 and
      .sourceManifestExists == true and .sourceEvidenceExists == true and
      .synthesisExists == true and .artifactExists == true' \
    "$feature_dir/state.json" >/dev/null
  jq --exit-status \
    '([.[] | select(.kind == "discover")] | length == 1) and
      ([.[] | select(.kind == "page")] | length == 1) and
      ([.[] | select(.kind == "synthesize")] | length == 1)' \
    "$feature_dir/provider.json" >/dev/null
  printf '%s\n' "$(jq --raw-output '.workflowId' "$feature_dir/state.json")" \
    >"$state_dir/research-report-workflow-id"
  complete_observation "$run_id" "$feature_dir"
  printf 'observed research-report state=%s provider=%s\n' \
    "$feature_dir/state.json" "$feature_dir/provider.json"
}

observe_document_build_free_denial() {
