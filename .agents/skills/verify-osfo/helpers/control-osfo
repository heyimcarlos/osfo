    '.userExists == false and .wakeUpCount == 0 and .sourceCount == 0 and .usageCount == 0 and
      .reminderSlo.elapsedMilliseconds >= 0 and
      .reminderSlo.elapsedMilliseconds <= 90000 and
      .handlerSlo.elapsedMilliseconds >= 0 and
      .handlerSlo.elapsedMilliseconds <= 60000 and
      .thinkRuntime.reminderVerification.occurrenceCount >= 1 and
      ([.thinkRuntime.reminderVerification.occurrences[] |
        select(.exposedAt != null and .thinkPresentedAt != null and .thinkSubmissionId != null)] |
        length) >= 1 and
      .deletionRuntimeBefore.reminderVerification.reminderCount >= 1 and
      .deletionRuntimeBefore.reminderVerification.occurrenceCount >= 1 and
      .deletionRuntimeBefore.reminderVerification.agentScheduleCount >= 0 and
      .deletionRuntimeBefore.reminderVerification.activeScheduleBindingCount >= 0 and
      .agentRuntimeAfter.inspectable == false and
      .agentRuntimeAfter.registered == false and
      .agentRuntimeAfter.reminderVerification == null' \
    "$feature_dir/state.json" >/dev/null
  jq --exit-status \
    '[.[] | select((.body | fromjson).type == "template")] as $templates |
      $templates | length == 1 and
      ($templates[0].body | fromjson) as $body |
      $body.template.name == "osfo_update" and
      ($body.template.language.code == "en" or $body.template.language.code == "es") and
      ($body.template | has("components") | not) and
      ($body | has("text") | not) and
      ($templates[0].recordedAt | fromdateiso8601) > 0' \
    "$feature_dir/provider.json" >/dev/null
  complete_observation "$run_id" "$feature_dir"
  printf 'observed whatsapp-wakeup state=%s provider=%s\n' \
    "$feature_dir/state.json" "$feature_dir/provider.json"
}

observe_account_deletion() {
  local run_id state_dir feature_dir container_id provider_origin phone user_id agent_id
  local channel_link_id target_tag unrelated_tag files_bucket target_key unrelated_key
  local postgres_state agent_runtime provider_ledger provider_containers target_exists unrelated_exists
  local worker_log account_http feature proof_shape research_state research_expected
  local research_manifest_exists research_source_exists research_synthesis_exists research_artifact_exists research_artifact_key
  local document_state document_expected document_source_exists document_artifact_exists
  local document_attempt_exists document_owner_exists document_source_key document_artifact_key
  local document_attempt_key document_owner_key document_file_id document_artifact_id
  local document_main_instance_id document_timer_instance_id artifacts_bucket
  run_id="$1"
  feature="$2"
  if [[ "$feature" == account-deletion-replay ]]; then
    proof_shape=retained-replay
  else
    proof_shape=one-click
  fi
  state_dir="$(state_dir_for "$run_id")"
  feature_dir="$(feature_artifact_dir_for "$run_id" "$feature")"
  begin_observation "$feature_dir"
  container_id="$(state_value "$run_id" container-id)"
  provider_origin="$(state_value "$run_id" provider-origin)"
  phone="$(state_value "$run_id" phone-e164)"
  user_id="$(state_value "$run_id" account-deletion-user-id)"
  agent_id="$(state_value "$run_id" account-deletion-agent-id)"
  channel_link_id="$(state_value "$run_id" account-deletion-channel-link-id)"
  target_tag="$(state_value "$run_id" account-deletion-target-provider-tag)"
  unrelated_tag="$(state_value "$run_id" account-deletion-unrelated-provider-tag)"
  files_bucket="$(state_value "$run_id" account-deletion-files-bucket)"
  target_key="$(state_value "$run_id" account-deletion-target-r2-key)"
  unrelated_key="$(state_value "$run_id" account-deletion-unrelated-r2-key)"
  worker_log="$(artifact_dir_for "$run_id")/logs/worker.log"
  require_owned_identifier 'User ID' "$user_id"
  require_owned_identifier 'Agent ID' "$agent_id"
  require_owned_identifier 'Channel Link ID' "$channel_link_id"

  postgres_state="$(docker exec --env PGPASSWORD=osfo "$container_id" \
    psql --dbname osfo --username osfo --tuples-only --no-align --set=ON_ERROR_STOP=1 \
    --command "select json_build_object(
      'userExists', exists(select 1 from users where id = '$user_id'),
      'agentExists', exists(select 1 from agents where agent_id = '$agent_id'),
      'authSessionExists', exists(select 1 from sessions where user_id = '$user_id'),
      'deletionCaseExists', exists(select 1 from deletion_cases where user_id = '$user_id'),
      'channelLinkExists', exists(select 1 from channel_links where channel_link_id = '$channel_link_id'),
      'acceptedInviteExists', exists(select 1 from channel_link_invites where accepted_user_id = '$user_id'),
      'channelAuditExists', exists(select 1 from channel_link_audit_events where user_id = '$user_id'),
      'billingExists', exists(select 1 from billing_subscriptions where user_id = '$user_id'),
      'allowanceExists', exists(select 1 from allowance_periods where user_id = '$user_id'),
      'whatsAppWakeUpExists', exists(select 1 from whatsapp_wakeups where user_id = '$user_id'),
      'whatsAppWakeUpSourceExists', exists(
        select 1 from whatsapp_wakeup_sources s
        join whatsapp_wakeups w on w.wakeup_id = s.wakeup_id
        where w.user_id = '$user_id'
      ),
      'researchReportExists', exists(select 1 from research_reports where user_id = '$user_id'),
      'researchProviderOperationExists', exists(
        select 1 from research_report_provider_operations o
        join research_reports r on r.workflow_id = o.workflow_id where r.user_id = '$user_id'
      ),
      'researchSynthesisOperationExists', exists(
        select 1 from research_report_synthesis_operations o
        join research_reports r on r.workflow_id = o.workflow_id where r.user_id = '$user_id'
      ),
      'researchNotificationExists', exists(select 1 from research_report_notifications where user_id = '$user_id'),
      'documentBuildExists', exists(select 1 from document_builds where user_id = '$user_id'),
      'documentNotificationExists', exists(select 1 from document_build_notifications where user_id = '$user_id'),
      'documentAccountingExists', exists(select 1 from allowance_usage where user_id = '$user_id' and source_type in ('documentBuild', 'documentProviderOperation')),
      'documentUsageEventExists', exists(select 1 from usage_events where user_id = '$user_id' and source_type = 'documentBuild'),
      'phoneVerificationExists', exists(select 1 from verifications where identifier = '$phone')
    );")"
  if r2_object_exists "$state_dir" "$files_bucket" "$target_key"; then
    target_exists=true
  else
    target_exists=false
  fi
  if r2_object_exists "$state_dir" "$files_bucket" "$unrelated_key"; then
    unrelated_exists=true
  else
    unrelated_exists=false
  fi
  research_state="$(feature_artifact_dir_for "$run_id" research-report)/state.json"
  research_expected=false
  research_manifest_exists=false
  research_source_exists=false
  research_synthesis_exists=false
  research_artifact_exists=false
  if [[ -s "$research_state" ]]; then
    research_expected=true
    if r2_object_exists "$state_dir" "$files_bucket" \
      "$(jq --exit-status --raw-output '.sourceManifestKey' "$research_state")"; then
      research_manifest_exists=true
    fi
    if r2_object_exists "$state_dir" "$files_bucket" \
      "$(jq --exit-status --raw-output '.sourceEvidenceKey' "$research_state")"; then
      research_source_exists=true
    fi
    if r2_object_exists "$state_dir" "$files_bucket" \
      "$(jq --exit-status --raw-output '.synthesisKey' "$research_state")"; then
      research_synthesis_exists=true
    fi
    research_artifact_key="client-content/$(VERIFICATION_CONTENT_ID="$(jq --exit-status --raw-output '.artifactContentId' "$research_state")" bun -e '
      process.stdout.write(Array.from(new TextEncoder().encode(process.env.VERIFICATION_CONTENT_ID), (byte) => byte.toString(16).padStart(2, "0")).join(""));
    ')"
    if r2_object_exists "$state_dir" \
      "$(jq --exit-status --raw-output '.r2_buckets[] | select(.binding == "ARTIFACTS") | .bucket_name' "$state_dir/wrangler.json")" \
      "$research_artifact_key"; then
      research_artifact_exists=true
    fi
  fi
  document_state="$(feature_artifact_dir_for "$run_id" document-build)/state.json"
  document_expected=false
  document_source_exists=false
  document_artifact_exists=false
  document_attempt_exists=false
  document_owner_exists=false
  if [[ -s "$document_state" ]]; then
    document_expected=true
    document_file_id="$(jq --exit-status --raw-output '.sourceFileId' "$document_state")"
    document_artifact_id="$(jq --exit-status --raw-output '.artifactContentId' "$document_state")"
    document_main_instance_id="$(jq --exit-status --raw-output '.cloudflareInstanceId' "$document_state")"
    document_timer_instance_id="$(jq --exit-status --raw-output '.cloudflareTimerInstanceId' "$document_state")"
    document_source_key="users/$(VERIFICATION_PART="$user_id" bun -e 'process.stdout.write(encodeURIComponent(process.env.VERIFICATION_PART))')/files/$(VERIFICATION_PART="$document_file_id" bun -e 'process.stdout.write(encodeURIComponent(process.env.VERIFICATION_PART))')/source"
    document_artifact_key="client-content/$(VERIFICATION_CONTENT_ID="$document_artifact_id" bun -e '
      process.stdout.write(Array.from(new TextEncoder().encode(process.env.VERIFICATION_CONTENT_ID), (byte) => byte.toString(16).padStart(2, "0")).join(""));
    ')"
    document_attempt_key="${document_artifact_key/client-content\//document-attempts/}"
    document_owner_key="document-owners/by-user/$(VERIFICATION_PART="$user_id" bun -e 'process.stdout.write(encodeURIComponent(process.env.VERIFICATION_PART))')/${document_artifact_key#client-content/}"
    artifacts_bucket="$(jq --exit-status --raw-output \
      '.r2_buckets[] | select(.binding == "ARTIFACTS") | .bucket_name' "$state_dir/wrangler.json")"
    if r2_object_exists "$state_dir" "$files_bucket" "$document_source_key"; then document_source_exists=true; fi
    if r2_object_exists "$state_dir" "$artifacts_bucket" "$document_artifact_key"; then document_artifact_exists=true; fi
    if r2_object_exists "$state_dir" "$artifacts_bucket" "$document_attempt_key"; then document_attempt_exists=true; fi
    if r2_object_exists "$state_dir" "$artifacts_bucket" "$document_owner_key"; then document_owner_exists=true; fi
    agent_runtime="$(inspect_agent_runtime "$run_id" "$agent_id" "$user_id" \
      "$document_file_id" "$document_main_instance_id" "$document_timer_instance_id" \
      "$document_artifact_id")"
  else
    agent_runtime="$(inspect_agent_runtime "$run_id" "$agent_id")"
  fi
  account_http="$("$script_dir/inspect-account-http-log" "$worker_log" "$proof_shape")"
  jq --null-input \
    --argjson postgres "$postgres_state" \
    --argjson agentRuntime "$agent_runtime" \
    --argjson targetR2Exists "$target_exists" \
    --argjson unrelatedR2Exists "$unrelated_exists" \
    --argjson researchProofExpected "$research_expected" \
    --argjson researchManifestExists "$research_manifest_exists" \
    --argjson researchSourceExists "$research_source_exists" \
    --argjson researchSynthesisExists "$research_synthesis_exists" \
    --argjson researchArtifactExists "$research_artifact_exists" \
    --argjson documentProofExpected "$document_expected" \
    --argjson documentSourceExists "$document_source_exists" \
    --argjson documentArtifactExists "$document_artifact_exists" \
    --argjson documentAttemptExists "$document_attempt_exists" \
    --argjson documentOwnerExists "$document_owner_exists" \
    --argjson accountHttp "$account_http" \
    --arg targetR2Key "$target_key" \
    --arg unrelatedR2Key "$unrelated_key" \
    '$postgres + {
      agentRuntime: $agentRuntime,
      accountHttp: $accountHttp,
      targetR2Exists: $targetR2Exists,
      targetR2Key: $targetR2Key,
      unrelatedR2Exists: $unrelatedR2Exists,
      unrelatedR2Key: $unrelatedR2Key,
      researchProofExpected: $researchProofExpected,
      researchManifestExists: $researchManifestExists,
      researchSourceExists: $researchSourceExists,
      researchSynthesisExists: $researchSynthesisExists,
      researchArtifactExists: $researchArtifactExists,
      documentProofExpected: $documentProofExpected,
      documentSourceExists: $documentSourceExists,
      documentArtifactExists: $documentArtifactExists,
      documentAttemptExists: $documentAttemptExists,
      documentOwnerExists: $documentOwnerExists
    }' >"$feature_dir/state.json"
  cp "$state_dir/account-deletion-agent-runtime-before.json" \
    "$feature_dir/agent-runtime-before.json"

  provider_ledger="$(curl --fail --silent --show-error \
    "$provider_origin/_test/supermemory/ledger")"
  provider_containers="$(curl --fail --silent --show-error \
    "$provider_origin/_test/supermemory/containers")"
  jq --null-input \
    --argjson containers "$provider_containers" \
    --argjson ledger "$provider_ledger" \
    --arg targetTag "$target_tag" \
    --arg unrelatedTag "$unrelated_tag" \
    '{ containers: $containers, ledger: $ledger, targetTag: $targetTag, unrelatedTag: $unrelatedTag }' \
    >"$feature_dir/provider.json"

  jq --exit-status \
    --argjson deleteRequests "$([[ "$proof_shape" == retained-replay ]] && printf 2 || printf 1)" \
    '(.userExists or .agentExists or .authSessionExists or .deletionCaseExists or
      .channelLinkExists or .acceptedInviteExists or .channelAuditExists or
      .billingExists or .allowanceExists or .whatsAppWakeUpExists or
      .whatsAppWakeUpSourceExists or .researchReportExists or
      .researchProviderOperationExists or .researchSynthesisOperationExists or
      .researchNotificationExists or .documentBuildExists or
      .documentNotificationExists or .documentAccountingExists or
      .documentUsageEventExists or .phoneVerificationExists) == false and
      .agentRuntime.inspectable == false and .agentRuntime.registered == false and
      .accountHttp.presentationRequests == 1 and
      .accountHttp.presentationSuccesses == 1 and
      .accountHttp.deleteRequests == $deleteRequests and
      .accountHttp.deleteSuccesses == $deleteRequests and
      .targetR2Exists == false and .unrelatedR2Exists == true and
      (.researchProofExpected == false or
        (.researchManifestExists == false and .researchSourceExists == false and
          .researchSynthesisExists == false and
          .researchArtifactExists == false))' \
    "$feature_dir/state.json" >/dev/null
  "$script_dir/assert-document-build-deletion-state" "$feature_dir/state.json"
  jq --exit-status \
    '.inspectable == true and .registered == true and
      .reminderVerification.reminderCount >= 0 and
      .reminderVerification.occurrenceCount >= 0 and
      .reminderVerification.agentScheduleCount >= 0 and
      .reminderVerification.activeScheduleBindingCount >= 0' \
    "$feature_dir/agent-runtime-before.json" >/dev/null
  jq --exit-status --arg target "$target_tag" --arg unrelated "$unrelated_tag" \
    '(.containers | index($target)) == null and
      (.containers | index($unrelated)) != null and
      [.ledger[] | select(.method == "DELETE")] == [
        { method: "DELETE", path: ("/v3/container-tags/" + $target) }
      ]' "$feature_dir/provider.json" >/dev/null
  complete_observation "$run_id" "$feature_dir"
  printf 'observed %s state=%s provider=%s agent_before=%s\n' "$feature" \
    "$feature_dir/state.json" "$feature_dir/provider.json" \
    "$feature_dir/agent-runtime-before.json"
}

evidence_finish() {
  local run_id feature feature_dir current_commit launch_commit launch_checkout
  run_id="$1"
  feature="$2"
  feature_dir="$(feature_artifact_dir_for "$run_id" "$feature")"
  launch_commit="$(state_value "$run_id" commit)"
  launch_checkout="$(state_value "$run_id" launch-checkout)"
  current_commit="$(git -C "$repo_root" rev-parse HEAD)"
  if [[ "$launch_commit" != "$current_commit" ]]; then
    printf 'Evidence is stale because HEAD changed after launch\n' >&2
    exit 1
  fi
  if [[ "$launch_checkout" != clean ]]; then
    printf 'Final evidence requires a checkout that was clean at launch. Treat this run as a draft.\n' >&2
    exit 1
  fi
  if [[ -n "$(git -C "$repo_root" status --porcelain --untracked-files=all)" ]]; then
    printf 'Final evidence requires a clean committed checkout. Treat this run as a draft.\n' >&2
    exit 1
  fi
  for required in \
    metadata.txt browser-actions.txt action.png result.png state.json provider.json \
    observation-passed.txt; do
    if [[ ! -s "$feature_dir/$required" ]]; then
      printf 'Evidence is incomplete: %s\n' "$feature_dir/$required" >&2
      exit 1
    fi
  done
  if [[ "$feature" == whatsapp-wakeup ]] && \
    { [[ ! -s "$feature_dir/nominal-due-at.txt" ]] || \
      [[ ! -s "$feature_dir/reminder-handler-slo.json" ]] || \
      [[ ! -s "$feature_dir/reminder-runtime.json" ]] || \
      [[ ! -s "$feature_dir/reminder-think-runtime.json" ]]; }; then
    printf 'WhatsApp Wake-up evidence needs the approved nominal due, occurrence SLO, and Think claim\n' >&2
    exit 1
  fi
  if [[ "$feature" == document-build-free-denial ]] && \
    { [[ ! -s "$feature_dir/agent-request.txt" ]] || \
      [[ ! -s "$feature_dir/agent-reply.txt" ]] || \
      ! grep -F -q 'launch-v1 Free safe denial' "$feature_dir/browser-actions.txt"; }; then
    printf 'Free Document Build denial evidence needs the exact Agent request, safe reply, and browser record\n' >&2
    exit 1
  fi
  if [[ "$feature" == conversation-memory ]] && \
    { ! grep -F -q 'ordinary Telegram reply and two Core Memory writes' \
        "$feature_dir/browser-actions.txt" || \
      ! grep -F -q 'Started a new Osfo session.' "$feature_dir/browser-actions.txt" || \
      ! grep -F -q 'corrected value visible and superseded value absent' \
        "$feature_dir/browser-actions.txt"; }; then
    printf 'Conversation Memory evidence needs the ordinary reply, both writes, exact new-Session reply, and corrected recall browser records\n' >&2
    exit 1
  fi
  if ! grep -q 'phase=action ' "$feature_dir/browser-actions.txt" || \
    ! grep -q 'phase=result ' "$feature_dir/browser-actions.txt"; then
    printf 'Evidence needs both action and result browser records\n' >&2
    exit 1
  fi
  if [[ "$feature" == account-deletion ]] && \
    { ! grep -F -q 'Permanent account removal requires confirmation.' \
        "$feature_dir/browser-actions.txt" || \
      ! grep -F -q 'Permanently delete this account and all of its data.' \
        "$feature_dir/browser-actions.txt" || \
      ! grep -F -q 'exactly one server-owned consequence' \
        "$feature_dir/browser-actions.txt" || \
      ! grep -F -q 'Sign in and Get started' \
        "$feature_dir/browser-actions.txt"; }; then
    printf 'Account-deletion evidence needs the generic prefetch, one exact server consequence, and signed-out result\n' >&2
    exit 1
  fi
  if [[ "$feature" == account-deletion-replay ]] && \
    { ! grep -F -q 'exact retained request after refresh' \
        "$feature_dir/browser-actions.txt" || \
      ! grep -F -q 'Sign in and Get started' \
        "$feature_dir/browser-actions.txt"; }; then
    printf 'Account-deletion replay evidence needs the exact retained request after refresh and signed-out result\n' >&2
    exit 1
  fi
  if [[ "$feature" == whatsapp-wakeup ]] && \
    { ! grep -F -q 'WhatsApp Channel Link accepted' \
        "$feature_dir/browser-actions.txt" || \
      ! grep -F -q 'one-time Reminder Approval accepted' \
        "$feature_dir/browser-actions.txt" || \
      ! grep -F -q 'exact Reminder body exposed before normal response' \
        "$feature_dir/browser-actions.txt" || \
      ! grep -F -q 'Channel Link revoked and later source produced no template' \
        "$feature_dir/browser-actions.txt" || \
      ! grep -F -q 'permanent account deletion completed' \
        "$feature_dir/browser-actions.txt"; }; then
    printf 'WhatsApp Wake-up evidence needs linked authority, exact Reminder Approvals and exposure, revocation no-send, and permanent deletion browser records\n' >&2
    exit 1
  fi
  printf 'completed_at=%s\nresult=PASS\ncommit=%s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$current_commit" >"$feature_dir/result.txt"
  printf 'verified feature=%s commit=%s evidence=%s\n' "$feature" "$current_commit" "$feature_dir"
}

cleanup_run() {
  local run_id state_dir container_id run_label artifact_dir
  run_id="$1"
  state_dir="$(state_dir_for "$run_id")"
  artifact_dir="$(artifact_dir_for "$run_id")"
  if [[ ! -e "$state_dir" ]]; then
    printf 'No active state to clean for run %s\n' "$run_id"
    return 0
  fi
  stop_process "$state_dir" web
  stop_process "$state_dir" worker
  stop_process "$state_dir" provider
  if [[ -s "$state_dir/container-id" ]]; then
    container_id="$(<"$state_dir/container-id")"
    if docker inspect "$container_id" >/dev/null 2>&1; then
      run_label="$(docker inspect --format '{{ index .Config.Labels "osfo.verification.run" }}' "$container_id")"
      if [[ "$run_label" != "$run_id" ]]; then
        printf 'Refusing to remove container with mismatched run label\n' >&2
        exit 1
      fi
      docker rm --force "$container_id" >/dev/null
    fi
  fi
  rm -r "$state_dir"
  printf 'cleaned run=%s evidence=%s\n' "$run_id" "$artifact_dir"
}

command_name="${1:-help}"
case "$command_name" in
  start)
    require_run_id "${2:-}"
    start_run "$2"
    ;;
  doctor)
    require_run_id "${2:-}"
    doctor_run "$2"
    ;;
  identity)
    require_run_id "${2:-}"
    show_identity "$2"
    ;;
  journeys)
    require_run_id "${2:-}"
    qualify_journeys "$2"
    ;;
  account-deletion-envelope-journey)
    require_run_id "${2:-}"
    qualify_account_deletion_envelope "$2"
    ;;
  evidence)
    require_run_id "${2:-}"
    require_feature "${3:-}"
    case "${4:-}" in
      start) evidence_start "$2" "$3" ;;
      finish) evidence_finish "$2" "$3" ;;
      *) usage >&2; exit 2 ;;
    esac
    ;;
  record)
    require_run_id "${2:-}"
    require_feature "${3:-}"
    record_browser "$2" "$3" "${4:-}" "${5:-}"
    ;;
  observe)
    require_run_id "${2:-}"
    require_feature "${3:-}"
    doctor_run "$2" >/dev/null
    case "$3" in
      registration) observe_registration "$2" ;;
      channel-linking) observe_channel_linking "$2" ;;
      conversation-memory) observe_conversation_memory "$2" ;;
      research-report) observe_research_report "$2" ;;
      document-build-free-denial) observe_document_build_free_denial "$2" ;;
      document-build) observe_document_build "$2" ;;
      immediate-gmail-send) observe_immediate_gmail_send "$2" ;;
      scheduled-email) observe_scheduled_email "$2" ;;
      billing) observe_billing "$2" ;;
      whatsapp-wakeup) observe_whatsapp_wakeup "$2" ;;
      account-deletion|account-deletion-replay) observe_account_deletion "$2" "$3" ;;
    esac
    ;;
  assert-conversation-memory-evidence)
    require_run_id "${2:-}"
    if [[ ! -s "${3:-}" || ! -s "${4:-}" ]]; then
      printf 'Conversation Memory state and provider evidence files are required\n' >&2
      exit 2
    fi
    assert_conversation_memory_evidence "$2" "$3" "$4"
    ;;
  channel-invite)
    require_run_id "${2:-}"
    channel_invite "$2"
    ;;
  telegram-reply)
    require_run_id "${2:-}"
    if [[ -z "${3:-}" ]]; then
      printf 'A Telegram message is required\n' >&2
      exit 2
    fi
    telegram_reply "$2" "$3"
    ;;
  document-build-free-denial)
    require_run_id "${2:-}"
    if [[ -z "${3:-}" ]]; then
      printf 'A browser-owned Document Build File ID is required\n' >&2
      exit 2
    fi
    document_build_free_denial "$2" "$3"
    ;;
  scheduled-email-request)
    require_run_id "${2:-}"
    scheduled_email_request "$2"
    ;;
  gmail-send-request)
    require_run_id "${2:-}"
    gmail_send_request "$2"
    ;;
  whatsapp-invite)
    require_run_id "${2:-}"
    whatsapp_invite "$2"
    ;;
  record-reminder-due)
    require_run_id "${2:-}"
    if [[ -z "${3:-}" ]]; then
      printf 'An RFC 3339 nominal due instant is required\n' >&2
      exit 2
    fi
    record_reminder_due "$2" "$3"
    ;;
  capture-reminder-occurrence)
    require_run_id "${2:-}"
    capture_reminder_occurrence "$2"
    ;;
  capture-reminder-think)
    require_run_id "${2:-}"
    capture_reminder_think "$2"
    ;;
  whatsapp-reply)
    require_run_id "${2:-}"
    if [[ -z "${3:-}" ]]; then
      printf 'WhatsApp reply text is required\n' >&2
      exit 2
    fi
    whatsapp_reply "$2" "$3"
    ;;
  seed-account-deletion)
    require_run_id "${2:-}"
    seed_account_deletion "$2"
    ;;
  reconcile-account-deletion)
    require_run_id "${2:-}"
    reconcile_account_deletion "$2"
    ;;
  cleanup)
    require_run_id "${2:-}"
    cleanup_run "$2"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
