  state_json="$(docker exec --env PGPASSWORD=osfo "$container_id" \
    psql --dbname osfo --username osfo --tuples-only --no-align --set=ON_ERROR_STOP=1 \
    --command "select json_build_object(
      'userId', u.id,
      'workflowId', se.workflow_id,
      'actionId', se.action_id,
      'agentId', se.agent_id,
      'cloudflareInstanceId', se.cloudflare_instance_id,
      'workflowCount', (select count(*) from scheduled_emails owned where owned.user_id = u.id),
      'state', se.state,
      'sendOutcome', se.send_outcome,
      'sendAccountingBasis', se.send_accounting_basis,
      'safeFailureCode', se.safe_failure_code,
      'providerLogId', se.provider_log_id,
      'providerResourceId', se.provider_resource_id,
      'request', se.request_json::jsonb,
      'approvalPresentation', se.approval_presentation::jsonb,
      'admittedAt', se.admitted_at,
      'acceptedAt', se.accepted_at,
      'waitingAt', se.waiting_at,
      'dueAt', se.due_at,
      'sendStartedAt', se.send_started_at,
      'sendOutcomeAt', se.send_outcome_at,
      'terminalAt', se.terminal_at,
      'dueToSendMilliseconds', extract(epoch from (se.send_started_at - se.due_at)) * 1000,
      'sendToTerminalMilliseconds', extract(epoch from (se.terminal_at - se.send_started_at)) * 1000,
      'terminalToFollowUpMilliseconds', extract(epoch from ((select n.accepted_at from scheduled_email_notifications n where n.workflow_id = se.workflow_id limit 1) - se.terminal_at)) * 1000,
      'notificationCount', (select count(*) from scheduled_email_notifications n where n.workflow_id = se.workflow_id),
      'acceptedNotifications', (select count(*) from scheduled_email_notifications n where n.workflow_id = se.workflow_id and n.accepted_at is not null and n.think_submission_id is not null),
      'workflowStartUsage', (select count(*) from allowance_usage a where a.user_id = u.id and a.source_type = 'workflow' and a.source_id = se.workflow_id and a.allowance_kind = 'workflowStarts'),
      'gmailSendUsage', (select count(*) from allowance_usage a where a.user_id = u.id and a.source_type = 'integrationAction' and a.source_id = se.action_id and a.allowance_kind = 'gmailSends'),
      'gmailSendBasis', (select a.basis from allowance_usage a where a.user_id = u.id and a.source_type = 'integrationAction' and a.source_id = se.action_id and a.allowance_kind = 'gmailSends' limit 1)
    ) from users u
    join lateral (
      select * from scheduled_emails where user_id = u.id order by admitted_at desc limit 1
    ) se on true
    where u.phone_number = '$phone';")"
  if [[ -z "$state_json" ]]; then
    printf 'No committed Scheduled Email found for the run-owned User\n' >&2
    exit 1
