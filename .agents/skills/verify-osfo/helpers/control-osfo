  fi
}

seed_account_deletion() {
  local run_id state_dir container_id provider_origin phone seed_state user_id agent_id
  local channel_link_id target_seed unrelated_seed target_tag unrelated_tag files_bucket
  local target_key unrelated_key containers_json agent_runtime
  run_id="$1"
  doctor_run "$run_id" >/dev/null
  state_dir="$(state_dir_for "$run_id")"
  if [[ -e "$state_dir/account-deletion-user-id" ]]; then
    printf 'Account-deletion evidence is already seeded for run %s\n' "$run_id" >&2
    exit 1
  fi
  container_id="$(state_value "$run_id" container-id)"
  provider_origin="$(state_value "$run_id" provider-origin)"
  phone="$(state_value "$run_id" phone-e164)"
  seed_state="$(docker exec --env PGPASSWORD=osfo "$container_id" \
    psql --dbname osfo --username osfo --tuples-only --no-align --set=ON_ERROR_STOP=1 \
    --command "select json_build_object(
      'userId', u.id,
      'agentId', a.agent_id,
      'channelLinkId', cl.channel_link_id
    ) from users u
    join agents a on a.user_id = u.id
    join channel_links cl on cl.user_id = u.id
    where u.phone_number = '$phone' and cl.channel_id = 'telegram' and cl.revoked_at is null;")"
  if [[ -z "$seed_state" ]]; then
    printf 'Complete registration and Telegram channel linking before deletion seeding\n' >&2
    exit 1
  fi
  user_id="$(jq --exit-status --raw-output '.userId' <<<"$seed_state")"
  agent_id="$(jq --exit-status --raw-output '.agentId' <<<"$seed_state")"
  channel_link_id="$(jq --exit-status --raw-output '.channelLinkId' <<<"$seed_state")"
  require_owned_identifier 'User ID' "$user_id"
  require_owned_identifier 'Agent ID' "$agent_id"
  require_owned_identifier 'Channel Link ID' "$channel_link_id"
  printf '%s\n' "$user_id" >"$state_dir/account-deletion-user-id"
  printf '%s\n' "$agent_id" >"$state_dir/account-deletion-agent-id"
  printf '%s\n' "$channel_link_id" >"$state_dir/account-deletion-channel-link-id"

  agent_runtime="$(inspect_agent_runtime "$run_id" "$agent_id")"
  jq --exit-status \
    '.inspectable == true and .registered == true' <<<"$agent_runtime" >/dev/null
  jq . <<<"$agent_runtime" >"$state_dir/account-deletion-agent-runtime-before.json"

  target_seed="$(curl --fail --silent --show-error \
    --header 'content-type: application/json' \
    --data "$(jq --null-input --compact-output --arg userId "$user_id" '{ userId: $userId }')" \
    "$provider_origin/_test/supermemory/seed")"
  unrelated_seed="$(curl --fail --silent --show-error \
    --header 'content-type: application/json' \
    --data "$(jq --null-input --compact-output --arg userId "unrelated-$run_id" '{ userId: $userId }')" \
    "$provider_origin/_test/supermemory/seed")"
  target_tag="$(jq --exit-status --raw-output '.containerTag' <<<"$target_seed")"
  unrelated_tag="$(jq --exit-status --raw-output '.containerTag' <<<"$unrelated_seed")"
  printf '%s\n' "$target_tag" >"$state_dir/account-deletion-target-provider-tag"
  printf '%s\n' "$unrelated_tag" >"$state_dir/account-deletion-unrelated-provider-tag"
  containers_json="$(curl --fail --silent --show-error \
    "$provider_origin/_test/supermemory/containers")"
  jq --exit-status --arg target "$target_tag" --arg unrelated "$unrelated_tag" \
    'index($target) != null and index($unrelated) != null' <<<"$containers_json" >/dev/null

  files_bucket="$(jq --exit-status --raw-output \
    '.r2_buckets[] | select(.binding == "FILES") | .bucket_name' "$state_dir/wrangler.json")"
  target_key="users/$user_id/trusted-evidence/$run_id.txt"
  unrelated_key="users/unrelated-$run_id/trusted-evidence/$run_id.txt"
  printf '%s\n' "$files_bucket" >"$state_dir/account-deletion-files-bucket"
  printf '%s\n' "$target_key" >"$state_dir/account-deletion-target-r2-key"
  printf '%s\n' "$unrelated_key" >"$state_dir/account-deletion-unrelated-r2-key"
  put_r2_object "$state_dir" "$files_bucket" "$target_key" \
    "run-owned trusted evidence for $user_id"
  put_r2_object "$state_dir" "$files_bucket" "$unrelated_key" \
    "unrelated User sentinel for $run_id"
  r2_object_exists "$state_dir" "$files_bucket" "$target_key"
  r2_object_exists "$state_dir" "$files_bucket" "$unrelated_key"

  printf 'deletion_seed_ready user=%s agent=%s channel_link=%s provider_target=%s r2_target=%s unrelated_sentinels=provider,r2\n' \
    "$user_id" "$agent_id" "$channel_link_id" "$target_tag" "$target_key"
}

reconcile_account_deletion() {
  local run_id state_dir container_id worker_origin user_id attempt user_exists
  run_id="$1"
  doctor_run "$run_id" >/dev/null
  state_dir="$(state_dir_for "$run_id")"
  container_id="$(state_value "$run_id" container-id)"
  worker_origin="$(state_value "$run_id" worker-origin)"
  user_id="$(state_value "$run_id" account-deletion-user-id)"
  require_owned_identifier 'User ID' "$user_id"
  curl --fail --silent --show-error "$worker_origin/cdn-cgi/handler/scheduled" >/dev/null
  for attempt in {1..120}; do
    user_exists="$(docker exec --env PGPASSWORD=osfo "$container_id" \
      psql --dbname osfo --username osfo --tuples-only --no-align --set=ON_ERROR_STOP=1 \
      --command "select exists(select 1 from users where id = '$user_id');")"
    if [[ "$user_exists" == f ]]; then
      printf 'scheduled_account_deletion_complete user=%s\n' "$user_id"
      return 0
    fi
    sleep 0.5
  done
  printf 'Production scheduled reconciliation did not complete account deletion for %s\n' \
    "$user_id" >&2
  exit 1
}

