  state_json="$(docker exec --env PGPASSWORD=osfo "$container_id" \
    psql --dbname osfo --username osfo --tuples-only --no-align --set=ON_ERROR_STOP=1 \
    --command "select json_build_object(
      'userId', u.id,
      'billingPlan', bs.plan,
      'billingPolicy', bs.plan_policy_version,
      'allowancePlan', ap.plan,
      'allowancePolicy', ap.plan_policy_version,
      'documentBuildCount', (select count(*) from document_builds db where db.user_id = u.id),
      'actionDocumentBuildCount', (select count(*) from document_builds db where db.user_id = u.id and db.action_id = '$action_id'),
      'workflowStartUsage', (select count(*) from allowance_usage a where a.user_id = u.id and a.source_type = 'documentBuild' and a.allowance_kind = 'workflowStarts'),
      'generatedDocumentUsage', (select count(*) from allowance_usage a where a.user_id = u.id and a.source_type = 'documentBuild' and a.allowance_kind = 'generatedDocuments'),
      'providerCostUsage', (select count(*) from allowance_usage a where a.user_id = u.id and a.source_type = 'documentProviderOperation' and a.allowance_kind = 'vendorUsdMicros'),
      'documentUsageEvents', (select count(*) from usage_events e where e.user_id = u.id and (e.root_operation_id = '$action_id' or e.root_operation_id = '$workflow_id' or e.source_type in ('documentBuild', 'documentProviderOperation'))),
      'documentNotificationCount', (select count(*) from document_build_notifications n join document_builds db on db.workflow_id = n.workflow_id where db.user_id = u.id)
    ) from users u
    join billing_subscriptions bs on bs.user_id = u.id
    join lateral (
      select plan, plan_policy_version from allowance_periods
      where user_id = u.id order by starts_at desc limit 1
    ) ap on true
    where u.phone_number = '$phone';")"
  if [[ -z "$state_json" ]]; then
    printf 'No launch-v1 Free User exists for the denial observation\n' >&2
    exit 1
  fi
  runtime="$(inspect_agent_runtime "$run_id" "$agent_id" "$user_id" "$file_id" \
    "$main_instance_id" "$timer_instance_id" "$artifact_id")"
  files_bucket="$(jq --exit-status --raw-output \
    '.r2_buckets[] | select(.binding == "FILES") | .bucket_name' "$state_dir/wrangler.json")"
  artifacts_bucket="$(jq --exit-status --raw-output \
    '.r2_buckets[] | select(.binding == "ARTIFACTS") | .bucket_name' "$state_dir/wrangler.json")"
  source_key="users/$(VERIFICATION_PART="$user_id" bun -e 'process.stdout.write(encodeURIComponent(process.env.VERIFICATION_PART))')/files/$(VERIFICATION_PART="$file_id" bun -e 'process.stdout.write(encodeURIComponent(process.env.VERIFICATION_PART))')/source"
  artifact_key="client-content/$(VERIFICATION_CONTENT_ID="$artifact_id" bun -e '
