#!/usr/bin/env bash
set -euo pipefail

if [[ "$#" -ne 4 ]]; then
  printf 'Usage: assert-document-build-free-denial <reply-file> <model-ledger-file> <action-id> <file-id>\n' >&2
  exit 2
fi

reply_file="$1"
model_ledger_file="$2"
action_id="$3"
file_id="$4"
expected_reply='Document Build is not available on your current plan.'

if [[ "$(<"$reply_file")" != "$expected_reply" ]]; then
  printf 'The Agent did not return the exact safe Document Build plan denial\n' >&2
  exit 1
fi

jq --exit-status \
  --arg actionId "$action_id" \
  --arg fileId "$file_id" \
  '([.[] | select(
      .kind == "tool-selection" and
      .operationId == "verification-loadSkill" and
      .selectedTool == "loadSkill" and
      .subject == "document-build@system-document-build-v1"
    )] | length) == 1 and
   ([.[] | select(
      .kind == "tool-selection" and
      .operationId == $actionId and
      .selectedTool == "startDocumentBuild" and
      .subject == $fileId
    )] | length) == 1' \
  "$model_ledger_file" >/dev/null
