{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "osfo-test",
  "main": "src/worker.ts",
  "rules": [{ "type": "Text", "globs": ["**/*.sql", "**/*.txt"], "fallthrough": true }],
  "compatibility_date": "2026-08-12",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI" },
  "vars": {
    "OSFO_STAGE": "test",
    "WHATSAPP_BOT_USERNAME": "osfo_test_whatsapp",
    "WHATSAPP_PHONE_NUMBER_ID": "123456789",
  },
  "secrets": {
    "required": [
      "BETTER_AUTH_API_KEY",
      "BETTER_AUTH_BASE_URL",
      "BETTER_AUTH_SECRET",
      "BETTER_AUTH_TRUSTED_ORIGINS",
      "WHATSAPP_ACCESS_TOKEN",
      "WHATSAPP_APP_SECRET",
      "WHATSAPP_VERIFY_TOKEN",
      "TWILIO_ACCOUNT_SID",
      "TWILIO_AUTH_TOKEN",
      "TWILIO_VERIFY_SERVICE_SID",
    ],
  },
  "hyperdrive": [
    {
      "binding": "DB",
      "id": "00000000-0000-0000-0000-000000000001",
      "localConnectionString": "postgres://osfo:osfo@127.0.0.1:5432/osfo_test",
    },
  ],
  "r2_buckets": [
    { "binding": "ARTIFACTS", "bucket_name": "osfo-test-generated-artifacts" },
    { "binding": "FILES", "bucket_name": "osfo-test-files" },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "DOCUMENT_SANDBOX", "class_name": "Sandbox" },
      { "name": "OSFO_DIRECTORY", "class_name": "OsfoDirectory" },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OsfoAgent", "RegistrationDialogue"],
    },
    { "tag": "v2", "new_sqlite_classes": ["Sandbox"] },
    { "tag": "v3", "new_sqlite_classes": ["OsfoDirectory"] },
    { "tag": "v4", "deleted_classes": ["RegistrationDialogue"] },
  ],
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./document-sandbox/Dockerfile",
      "instance_type": "lite",
      "max_instances": 20,
    },
  ],
  "triggers": { "crons": ["0 * * * *"] },
  "workflows": [
    {
      "binding": "EXECUTION_UNIT_WORKFLOW",
      "name": "osfo-test-execution-unit",
      "class_name": "ExecutionUnitWorkflow",
    },
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 1 },
  },
}
