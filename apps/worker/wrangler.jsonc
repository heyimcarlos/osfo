{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "osfo-test",
  "main": "src/worker.ts",
  "rules": [{ "type": "Text", "globs": ["**/*.sql", "**/*.py"], "fallthrough": true }],
  "compatibility_date": "2026-08-12",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI" },
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "osfo-test-files" }],
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile.files",
      "instance_type": "lite",
      "max_instances": 1,
    },
  ],
  "vars": {
    "OSFO_STAGE": "test",
    "WHATSAPP_PHONE_NUMBER": "14165550100",
  },
  "secrets": {
    "required": [
      "BETTER_AUTH_API_KEY",
      "BETTER_AUTH_BASE_URL",
      "BETTER_AUTH_SECRET",
      "BETTER_AUTH_TRUSTED_ORIGINS",
      "TWILIO_ACCOUNT_SID",
      "TWILIO_AUTH_TOKEN",
      "TWILIO_VERIFY_SERVICE_SID",
    ],
  },
  "hyperdrive": [
    {
      "binding": "DB",
      "id": "00000000-0000-0000-0000-000000000001",
      "localConnectionString": "postgres://osfo:osfo@127.0.0.1:5432/osfo_test",
    },
  ],
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [
      { "name": "OSFO_AGENT", "class_name": "OsfoAgent" },
      { "name": "FILE_COMPUTE", "class_name": "Sandbox" },
      {
        "name": "REGISTRATION_DIALOGUE",
        "class_name": "RegistrationDialogue",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OsfoAgent", "RegistrationDialogue"],
    },
    { "tag": "v2", "new_sqlite_classes": ["Sandbox"] },
  ],
  "triggers": { "crons": ["0 * * * *"] },
  "workflows": [
    {
      "binding": "EXECUTION_UNIT_WORKFLOW",
      "name": "osfo-test-execution-unit",
      "class_name": "ExecutionUnitWorkflow",
    },
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 1 },
  },
}
