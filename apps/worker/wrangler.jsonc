{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "osfo-test",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "OSFO_STAGE": "test",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "osfo-test-db",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "src/db/migrations",
      "migrations_pattern": "src/db/migrations/*/migration.sql",
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "OSFO_AGENT", "class_name": "OsfoAgent" },
      {
        "name": "REGISTRATION_DIALOGUE",
        "class_name": "RegistrationDialogue",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OsfoAgent", "RegistrationDialogue"],
    },
  ],
  "workflows": [
    {
      "binding": "EXECUTION_UNIT_WORKFLOW",
      "name": "osfo-test-execution-unit",
      "class_name": "ExecutionUnitWorkflow",
    },
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 1 },
  },
}
