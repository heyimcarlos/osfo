{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "osfo-test",
  "main": "src/worker.ts",
  "rules": [{ "type": "Text", "globs": ["**/*.sql", "**/*.txt"], "fallthrough": true }],
  "compatibility_date": "2026-08-12",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "WHATSAPP_ACCESS_TOKEN": "test-only-whatsapp-access-token",
    "WHATSAPP_APP_SECRET": "test-only-whatsapp-app-secret",
    "WHATSAPP_BOT_USERNAME": "osfo_test_whatsapp",
    "WHATSAPP_PHONE_NUMBER_ID": "123456789",
    "WHATSAPP_VERIFY_TOKEN": "test-only-whatsapp-verify-token",
    "OSFO_STAGE": "test",
    "STRIPE_ADVENTURER_PRICE_ID": "price_adventurer",
    "STRIPE_ADVENTURER_PRODUCT_ID": "prod_adventurer",
    "STRIPE_PORTAL_CONFIGURATION_ID": "bpc_approved",
    "STRIPE_SECRET_KEY": "sk_test_osfo",
    "STRIPE_WEBHOOK_SECRET": "whsec_test_osfo",
  },
  "hyperdrive": [
    {
      "binding": "DB",
      "id": "00000000-0000-0000-0000-000000000001",
      "localConnectionString": "postgres://osfo:osfo@127.0.0.1:5432/osfo_test",
    },
  ],
  "r2_buckets": [
    { "binding": "ARTIFACTS", "bucket_name": "osfo-test-generated-artifacts" },
    { "binding": "FILES", "bucket_name": "osfo-test-files" },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "DOCUMENT_SANDBOX", "class_name": "Sandbox" },
      { "name": "OSFO_DIRECTORY", "class_name": "OsfoDirectory" },
      // Direct OsfoAgent binding for isolated behavior tests. Topology tests use OSFO_DIRECTORY.
      { "name": "OSFO_AGENT_TEST_FACET", "class_name": "OsfoAgent" },
      { "name": "COMPANY_AGENT_TEST_FACET", "class_name": "CompanyAgent" },
      {
        "name": "THINK_MESSENGER_STATE_TEST",
        "class_name": "ThinkMessengerStateAgent",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OsfoAgent", "RegistrationDialogue"],
    },
    { "tag": "v2", "new_sqlite_classes": ["Sandbox"] },
    { "tag": "v3", "new_sqlite_classes": ["OsfoDirectory"] },
    { "tag": "v4", "deleted_classes": ["RegistrationDialogue"] },
    { "tag": "v5", "new_sqlite_classes": ["CompanyAgent"] },
  ],
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./document-sandbox/Dockerfile",
      "instance_type": "lite",
      "max_instances": 20,
    },
  ],
  "workflows": [
    {
      "binding": "EXECUTION_UNIT_WORKFLOW",
      "name": "osfo-test-execution-unit",
      "class_name": "ExecutionUnitWorkflow",
    },
  ],
}
