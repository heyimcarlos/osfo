{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "osfo-test",
  "main": "src/worker.ts",
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "compatibility_date": "2026-08-12",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "META_APP_SECRET": "test-only-meta-app-secret",
    "META_WEBHOOK_VERIFY_TOKEN": "test-only-meta-webhook-token",
    "OSFO_STAGE": "test",
  },
  "hyperdrive": [
    {
      "binding": "DB",
      "id": "00000000-0000-0000-0000-000000000001",
      "localConnectionString": "postgres://osfo:osfo@127.0.0.1:5432/osfo_test",
    },
  ],
  "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "osfo-test-generated-artifacts" }],
  "durable_objects": {
    "bindings": [
      { "name": "DOCUMENT_SANDBOX", "class_name": "Sandbox" },
      { "name": "OSFO_AGENT", "class_name": "OsfoAgent" },
      { "name": "REGISTRATION_DIALOGUE", "class_name": "RegistrationDialogue" },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OsfoAgent", "RegistrationDialogue"],
    },
    { "tag": "v2", "new_sqlite_classes": ["Sandbox"] },
  ],
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./document-sandbox/Dockerfile",
      "instance_type": "lite",
      "max_instances": 20,
    },
  ],
  "workflows": [
    {
      "binding": "EXECUTION_UNIT_WORKFLOW",
      "name": "osfo-test-execution-unit",
      "class_name": "ExecutionUnitWorkflow",
    },
  ],
}
