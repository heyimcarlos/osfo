{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "osfo-worker-journeys",
  "main": "../src/worker.ts",
  "rules": [{ "type": "Text", "globs": ["**/*.sql", "**/*.txt"], "fallthrough": true }],
  "compatibility_date": "2026-08-12",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "OSFO_STAGE": "test" },
  "r2_buckets": [
    { "binding": "ARTIFACTS", "bucket_name": "osfo-test-generated-artifacts" },
    { "binding": "FILES", "bucket_name": "osfo-test-files" },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "DOCUMENT_SANDBOX", "class_name": "Sandbox" },
      { "name": "OSFO_DIRECTORY", "class_name": "OsfoDirectory" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["OsfoAgent", "RegistrationDialogue"] },
    { "tag": "v2", "new_sqlite_classes": ["Sandbox"] },
    { "tag": "v3", "new_sqlite_classes": ["OsfoDirectory"] },
    { "tag": "v4", "deleted_classes": ["RegistrationDialogue"] },
  ],
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "../document-sandbox/Dockerfile",
      "instance_type": "lite",
      "max_instances": 20,
    },
  ],
  "workflows": [
    {
      "binding": "EXECUTION_UNIT_WORKFLOW",
      "name": "osfo-test-execution-unit",
      "class_name": "ExecutionUnitWorkflow",
    },
    {
      "binding": "RESEARCH_REPORT_WORKFLOW",
      "name": "osfo-test-research-report",
      "class_name": "ResearchReportWorkflow",
    },
    {
      "binding": "RESEARCH_REPORT_TIMER_WORKFLOW",
      "name": "osfo-test-research-report-timer",
      "class_name": "ResearchReportTimerWorkflow",
    },
  ],
}
