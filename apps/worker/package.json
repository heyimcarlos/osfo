{
  "name": "@osfo/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./config": "./src/config.ts",
    "./workflow-contracts": "./src/workflow-contracts.ts"
  },
  "scripts": {
    "agent-db:check": "drizzle-kit check --config drizzle.agent.config.ts",
    "agent-db:generate": "drizzle-kit generate --config drizzle.agent.config.ts",
    "build": "wrangler deploy --dry-run --outdir dist",
    "dev": "bun --cwd ../..  alchemy dev --stage development --env-file apps/worker/.env",
    "test": "vitest run --config vitest.modules.config.ts && vitest run --config vitest.runtime.config.ts && node ../../node_modules/.bin/vitest run --config vitest.node.config.ts && vitest run --config vitest.file-task.config.ts && bun run test:renderer",
    "test:journeys:account-deletion-envelope": "vitest run --config vitest.composed.config.ts test/composed/account-deletion-envelope.test.ts",
    "test:journeys": "vitest run --config vitest.journeys.config.ts",
    "test:live:supermemory": "bun --env-file=.env --bun x vitest run --config vitest.live.config.ts",
    "test:renderer": "docker build --file document-sandbox/Dockerfile --tag osfo-document-renderer-test document-sandbox",
    "typecheck": "wrangler types --check && tsc --noEmit"
  },
  "dependencies": {
    "@chat-adapter/telegram": "4.38.1",
    "@chat-adapter/whatsapp": "4.38.1",
    "@cloudflare/sandbox": "0.12.7",
    "@cloudflare/think": "0.15.1",
    "@composio/client": "0.1.0-alpha.76",
    "@composio/core": "0.17.0",
    "@effect/platform-browser": "catalog:",
    "@noble/hashes": "2.3.0",
    "@osfo/api": "workspace:*",
    "@osfo/auth": "workspace:*",
    "@osfo/db": "workspace:*",
    "agents": "0.20.1",
    "ai": "7.0.66",
    "better-auth": "1.6.28",
    "drizzle-orm": "0.45.2",
    "effect": "catalog:",
    "fflate": "0.8.2",
    "pdf-lib": "1.17.1",
    "postgres": "3.4.9",
    "stripe": "22.5.0",
    "supermemory": "4.25.4",
    "workers-ai-provider": "4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@effect/vitest": "catalog:",
    "chat": "4.38.1",
    "drizzle-kit": "0.31.10",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
