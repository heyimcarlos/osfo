{
  "name": "@osfo/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./config": "./src/config.ts"
  },
  "scripts": {
    "agent-db:check": "drizzle-kit check --config drizzle.agent.config.ts",
    "agent-db:generate": "drizzle-kit generate --config drizzle.agent.config.ts",
    "build": "wrangler deploy --dry-run --outdir dist",
    "dev": "bun --cwd ../..  alchemy dev --stage development --env-file apps/worker/.env",
    "test": "vitest run --config vitest.config.ts && vitest run --config vitest.db.config.ts && vitest run --config vitest.file-task.config.ts && bun run test:renderer",
    "test:renderer": "docker build --file document-sandbox/Dockerfile --tag osfo-document-renderer-test document-sandbox",
    "test:postgres": "vitest run --config vitest.real-db.config.ts",
    "typecheck": "wrangler types --check && tsc --noEmit"
  },
  "dependencies": {
    "@chat-adapter/telegram": "4.38.0",
    "@chat-adapter/whatsapp": "4.38.0",
    "@cloudflare/sandbox": "0.12.7",
    "@cloudflare/think": "0.15.1",
    "@effect/platform-browser": "catalog:",
    "@osfo/api": "workspace:*",
    "@osfo/auth": "workspace:*",
    "@osfo/db": "workspace:*",
    "agents": "0.20.1",
    "ai": "7.0.66",
    "better-auth": "1.6.29",
    "drizzle-orm": "0.45.2",
    "effect": "catalog:",
    "fflate": "0.8.3",
    "pdf-lib": "1.17.1",
    "postgres": "3.4.9",
    "stripe": "22.5.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@effect/vitest": "catalog:",
    "@electric-sql/pglite": "0.5.5",
    "drizzle-kit": "0.31.10",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
