{
  "name": "@osfo/agent-run-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/streaming-pull.d.ts",
      "development": "./src/streaming-pull.ts",
      "default": "./dist/streaming-pull.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "node --import tsx src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run --exclude '**/*.postgres.test.ts' --exclude '**/.typescript/**' --exclude '**/dist/**'",
    "test:postgres": "vitest run test/*.postgres.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@google-cloud/pubsub": "6.0.0",
    "@osfo/agent-run": "workspace:*",
    "@osfo/agent-runtime": "workspace:*",
    "@osfo/db": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
